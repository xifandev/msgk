# Nuxt/Nitro 运行时使用 NITRO_ 前缀覆盖 runtimeConfig。
# 复制为 .env 后填写；真实 .env 永不提交。
NITRO_DB_HOST=127.0.0.1
NITRO_DB_PORT=3306
NITRO_DB_NAME=msgk
NITRO_DB_USER=
NITRO_DB_PASSWORD=

NITRO_AUTH_SECRET=
NITRO_ALIYUN_ACCESS_KEY_ID=
NITRO_ALIYUN_ACCESS_KEY_SECRET=
NITRO_SMS_SIGN_NAME=
NITRO_SMS_TEMPLATE_CODE=
NITRO_SMS_MOCK=1

NITRO_OSS_BUCKET=
NITRO_OSS_REGION=oss-cn-hangzhou
NITRO_SITE_BASE_URL=
