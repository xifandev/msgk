/**app.wxss**/
page {
  --ms-primary: #d31027;
  --ms-primary-deep: #b31217;
  --ms-text: #323233;
  --ms-text-2: #646566;
  --ms-text-3: #969799;
  --ms-bg: #f1f2f4;
  --ms-line: #ebedf0;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #323233;
  background-color: #f1f2f4;
}

view,
text,
image,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

image {
  display: block;
}
