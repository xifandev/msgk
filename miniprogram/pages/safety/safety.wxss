.corner-icon {
  position: absolute;
  right: 38rpx;
  top: 30rpx;
  font-size: 64rpx;
  color: rgba(255, 255, 255, 0.75);
  z-index: 1;
}

.news-item {
  display: flex;
  flex-direction: column;
}

.news-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #3b3a39;
}

.news-time {
  color: #b9b9b9;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.load-status {
  text-align: center;
  font-size: 24rpx;
  color: #969799;
  padding: 30rpx 0;
}
