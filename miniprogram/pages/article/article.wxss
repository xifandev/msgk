.head-box {
  padding: 40rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.4;
  color: #323233;
}

.article-time {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #969799;
}

.content-box {
  padding: 30rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #3b3a39;
}

.bottom-gap {
  height: 100rpx;
}
