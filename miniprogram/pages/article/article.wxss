/* 文章详情页 */
page {
  background-color: #f2f3f5;
}

.article-page {
  position: relative;
  min-height: 100vh;
  padding: 0 24rpx;
  background-color: #f2f3f5;
}

/* 顶部红色氛围带 */
.article-band {
  position: absolute;
  top: 0;
  left: -24rpx;
  right: -24rpx;
  height: 320rpx;
  background: linear-gradient(180deg, #fdeff0 0%, rgba(242, 243, 245, 0) 100%);
  pointer-events: none;
}

/* ---------- 标题区 ---------- */
.article-hero {
  position: relative;
  padding: 32rpx 28rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}

.article-kicker {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #fdeef0;
}

.article-kicker__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d31027;
  margin-right: 10rpx;
}

.article-kicker text {
  font-size: 22rpx;
  color: #d31027;
  letter-spacing: 1rpx;
}

.article-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #1a1c1f;
  letter-spacing: 1rpx;
  word-break: break-word;
}

.article-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f3f5;
}

.article-meta__item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8f939a;
  line-height: 1.5;
}

.article-meta__item text {
  margin-left: 8rpx;
}

/* ---------- 封面 ---------- */
.article-cover {
  margin-top: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}

.article-cover__img {
  display: block;
  width: 100%;
}

/* ---------- 正文 ---------- */
.article-card {
  margin-top: 24rpx;
  padding: 34rpx 30rpx 12rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 35, 41, 0.06);
}

.article-body {
  font-size: 30rpx;
  color: #3b3a39;
  line-height: 1.9;
  word-break: break-word;
}

.article-empty {
  padding: 40rpx 0 20rpx;
}

/* 结束符 */
.article-end {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 0 26rpx;
}

.article-end__line {
  width: 56rpx;
  height: 1rpx;
  background: #e6e8eb;
}

.article-end text {
  margin: 0 18rpx;
  font-size: 22rpx;
  color: #b9bbbf;
  letter-spacing: 2rpx;
}

.article-tip {
  margin-top: 24rpx;
  padding: 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8f939a;
  line-height: 1.7;
}

.article-bottom-gap {
  height: calc(env(safe-area-inset-bottom) + 60rpx);
}

/* ---------- 失败态 ---------- */
.article-fail {
  min-height: 100vh;
  background-color: #f2f3f5;
  padding-top: 160rpx;
}
