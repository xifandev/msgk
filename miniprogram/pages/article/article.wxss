/* 文章详情：沿用旧版灰底纸面阅读样式 */
page {
  background-color: #f8f8fa;
}

.article-page {
  min-height: 100vh;
  background-color: #f8f8fa;
}

.news-head {
  width: 100%;
  padding: 20rpx 40rpx 0;
}

.news-title {
  font-size: 38rpx;
  margin-top: 10rpx;
  font-weight: 500;
  line-height: 1.5;
  padding-bottom: 20rpx;
  border-bottom: 1px solid #c1c5ce;
  color: #323233;
}

.news-time {
  color: #999;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.news-body {
  margin: 0 40rpx;
  padding-bottom: 100rpx;
  line-height: 26px;
  letter-spacing: 1.3px;
  font-size: 30rpx;
  color: #3b3a39;
  word-break: break-all;
}

.news-body image,
.news-body img {
  max-width: 100% !important;
  height: auto !important;
}

.bottom-gap {
  height: 100rpx;
}
