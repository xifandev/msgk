/* ---------- 书本卡片（旧版 1:1，青蓝色渐变） ---------- */
.book {
  width: 125rpx;
  height: 146rpx;
  display: flex;
  flex-wrap: wrap;
  align-content: space-between;
  color: #fff;
  padding: 20rpx;
  border-radius: 8px;
  background: linear-gradient(to bottom, #4dd9f4, #2db8e3);
  /* 旧版为 content-box（全局样式是 border-box），显式还原尺寸计算方式 */
  box-sizing: content-box;
  flex-shrink: 0;
}

.book-title {
  height: 100rpx;
  width: 100%;
  overflow: hidden;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  opacity: 0.9;
}

.book-title-icon {
  margin-right: 8rpx;
}

.book-top {
  width: 100%;
}

.book-miaoshu {
  width: 100%;
  padding-left: 8rpx;
  font-size: 20rpx;
  margin-top: 6px;
  background: linear-gradient(to right, #2eb3db, transparent);
}

.book-hengtiao {
  background-color: white;
  height: 15rpx;
  width: 170rpx;
  margin-bottom: 6rpx;
  margin-left: 3rpx;
  border-radius: 10px;
}

.book-fangkuai {
  width: 25rpx;
  height: 25rpx;
  background: rgba(255, 255, 255, 0.5);
  margin-left: 5px;
  margin-top: 5px;
  margin-bottom: 5px;
  /* 倾斜 45° */
  transform: rotate(45deg);
  opacity: 1;
}

.book-tuxing {
  display: flex;
  justify-content: center;
}

.book-fangkuai:nth-of-type(1) {
  /* 透明度 30% */
  opacity: 0.3;
}

.book-fangkuai:nth-of-type(2) {
  /* 透明度 50% */
  opacity: 0.5;
}

.book-fangkuai:nth-of-type(3) {
  opacity: 1;
}

.book-bottom {
  width: 100%;
}

/* ---------- 右侧文字（旧版 1:1） ---------- */
.news_box {
  display: flex;
  align-items: center;
}

.news_item {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  justify-items: center;
  align-content: center;
  margin-left: 10px;
}

.news_content {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.news_time {
  color: #b9b9b9;
  font-size: 14px;
}

.news_title {
  width: 100%;
  font-size: 28rpx;
  max-height: 85rpx;
  margin-bottom: 10px;
  overflow: hidden;
  color: #3b3a39;
}

/* ---------- 标签页与加载态 ---------- */
.tab-gap {
  height: 10px;
}

.loading-box {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}
