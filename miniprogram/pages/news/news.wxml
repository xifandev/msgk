<!-- 政策法规：按旧版 fagui 页 1:1 还原，vant 已全部替换为 ms-* 自研组件 -->
<page-main title="法律法规 最新政策" title1="速览最新政策" title2="学习强国理念" title3="紧跟时代步伐">
  <!-- 首次加载分类中 -->
  <view class="loading-box" wx:if="{{ !loaded && categories.length === 0 }}">
    <ms-loading />
  </view>
  <!-- 无分类空态 -->
  <ms-empty wx:elif="{{ loaded && categories.length === 0 }}" description="暂时没有分类" />
  <!-- 分类标签 + 文章列表 -->
  <ms-tabs
    wx:else
    tabs="{{ tabs }}"
    active="{{ activeIndex }}"
    swipeable
    ellipsis="{{ false }}"
    bind:change="onTabChange"
  >
    <view class="tab-gap"></view>
    <!-- 当前分类加载中 -->
    <view class="loading-box" wx:if="{{ !loaded }}">
      <ms-loading />
    </view>
    <!-- 当前分类无文章 -->
    <ms-empty wx:elif="{{ list.length === 0 }}" description="暂时没有文章" />
    <!-- 书本卡片列表 -->
    <block wx:else>
      <ms-cell
        wx:for="{{ list }}"
        wx:key="id"
        wx:for-item="article"
        bind:click="openArticle"
        data-id="{{ article.id }}"
      >
        <view slot="title">
          <view class="news_box">
            <view class="book">
              <view class="book-top">
                <view class="book-title">
                  <text wx:if="{{ article.summary }}">{{ article.summary }}</text>
                  <block wx:else>
                    <ms-icon class="book-title-icon" name="star" size="30rpx" color="#fff" />
                    <text>法规政策</text>
                  </block>
                </view>
              </view>
              <view class="book-bottom">
                <view class="book-tuxing">
                  <view class="book-fangkuai"></view>
                  <view class="book-fangkuai"></view>
                  <view class="book-fangkuai"></view>
                </view>
                <view class="book-hengtiao"></view>
              </view>
            </view>
            <view class="news_item">
              <view class="news_content">
                <view class="news_title">{{ article.title }}</view>
                <view class="news_time">
                  <text>发布日期：</text>
                  <text>{{ article.date }}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </ms-cell>
    </block>
  </ms-tabs>
</page-main>
