<view class="bgc"></view>

<!-- 全屏沉浸式：仅覆盖状态栏的渐隐蒙层，保证状态栏文字在滚动后依然可读 -->
<view class="status-veil" style="height:{{ statusBarHeight }}px"></view>

<!-- 固定返回按钮 -->
<view
  class="nav-back"
  style="top:{{ statusBarHeight + 6 }}px"
  hover-class="nav-back--hover"
  bind:tap="goBack"
  aria-role="button"
  aria-label="返回"
>
  <ms-icon name="arrow-left" size="34rpx" color="#ffffff" />
</view>

<view class="page-head" style="padding-top:{{ safeTop }}px">
  <view class="top-img-wrap" style="top:{{ safeTop }}px">
    <image class="top-img" src="/assets/images/xing5.png" mode="widthFix" />
    <image class="top-img-gezi" src="/assets/images/gezi.png" mode="widthFix" />
  </view>
  <view class="title-box">
    <view class="top-title">场所介绍</view>
    <view class="top-title2">{{ venue ? venue.name : '了解场所的基本情况与简介' }}</view>
  </view>
</view>

<!-- 白色内容区 -->
<view class="sheet">
  <!-- 加载中 -->
  <view wx:if="{{ !loaded }}" class="sheet-state">
    <ms-loading text="正在加载" />
  </view>

  <!-- 无数据：整页空态 -->
  <view wx:elif="{{ !venue }}" class="sheet-state">
    <ms-empty description="暂无场所信息" />
  </view>

  <block wx:else>
    <!-- 场所概况：名称 + 小尺寸文字标签 + 拨打 -->
    <view class="content-card">
      <view class="venue-top">
        <view class="venue-top__body">
          <view class="venue-top__name">{{ venue.name }}</view>
          <view class="venue-top__tags">
            <view class="venue-top__tag" wx:if="{{ venue.township }}">{{ venue.township }}</view>
            <view class="venue-top__tag" wx:if="{{ venue.profile.category }}">{{ venue.profile.category }}</view>
            <view class="venue-top__tag" wx:if="{{ venue.profile.religion }}">{{ venue.profile.religion }}</view>
            <view class="venue-top__tag" wx:if="{{ venue.profile.registrationDate }}">{{ venue.profile.registrationDate }}</view>
            <view class="venue-top__tag venue-top__tag--ok">
              <ms-icon name="passed" size="22rpx" color="#31b380" />
              <text>已审核公开</text>
            </view>
          </view>
        </view>
        <view
          wx:if="{{ venue.profile.phone }}"
          class="venue-top__call"
          hover-class="venue-top__call--hover"
          bind:tap="callPhone"
          aria-role="button"
          aria-label="拨打场所联系电话"
        >
          <ms-icon name="phone" size="28rpx" color="#d31027" />
          <text>拨打</text>
        </view>
      </view>
    </view>

    <!-- 场所简介：视觉主角 -->
    <view class="summary-card" wx:if="{{ summaryHtml }}">
      <view class="summary-quote">“</view>
      <view class="summary-title">场所简介</view>
      <view class="summary-rule"></view>
      <view class="summary-body">
        <rich-text nodes="{{ summaryHtml }}"></rich-text>
      </view>
      <view class="summary-note">
        <ms-icon name="bulb-o" size="24rpx" color="#b0b3b8" />
        <text>简介内容由场所登记单位提供并公开</text>
      </view>
    </view>

    <!-- 无简介：空态 -->
    <view class="content-card" wx:else>
      <ms-empty description="暂无场所简介" />
    </view>
  </block>
</view>
