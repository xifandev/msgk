<page-main title="{{ venue.name || '场所介绍' }}">
  <!-- 加载中 -->
  <ms-loading wx:if="{{ !loaded }}" text="正在加载" />

  <!-- 无数据：整页空态（与旧版一致） -->
  <ms-empty wx:elif="{{ !venue || !venue.profile }}" description="暂无场所信息" />

  <!-- 有数据：场所简介 / 登记注册信息 两个标签 -->
  <ms-tabs
    wx:else
    tabs="{{ ['场所简介','登记注册信息'] }}"
    active="{{ tabIndex }}"
    bind:change="onTabChange"
  >
    <!-- 场所简介 -->
    <block wx:if="{{ tabIndex === 0 }}">
      <view class="jianjie" wx:if="{{ venue.profile.summary }}">
        <rich-text nodes="{{ venue.profile.summary }}" />
      </view>
      <ms-empty wx:else description="暂无场所信息" />
    </block>

    <!-- 登记注册信息 -->
    <block wx:else>
      <view style="height:20rpx"></view>
      <ms-cell title="登记时间" value="{{ venue.profile.registrationDate || '—' }}" />
      <ms-cell title="宗教" value="{{ venue.profile.religion || '—' }}" />
      <ms-cell title="场所类别" value="{{ venue.profile.category || '—' }}" />
      <ms-cell title="场所负责人" value="{{ venue.profile.manager || '—' }}" />
      <ms-cell title="联系电话" value="{{ venue.profile.phone || '—' }}" />
      <ms-cell title="批准设立机构" value="{{ venue.profile.approvalAuthority || '—' }}" />
      <ms-cell title="地址" label="{{ venue.profile.address || '—' }}" />
      <ms-cell title="统一社会信用代码" label="{{ venue.profile.creditCode || '—' }}" border="{{ false }}" />
    </block>
  </ms-tabs>

  <view style="height:20rpx"></view>
</page-main>
