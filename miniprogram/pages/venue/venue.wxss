/* 场所介绍页 */

/* ---------- 概况卡 ---------- */
.venue-hero {
  position: relative;
  margin: 24rpx 24rpx 12rpx;
  padding: 30rpx 28rpx 8rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #d31027 0%, #e63c4c 52%, #f2606a 100%);
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(211, 16, 39, 0.24);
}

.venue-hero__glow {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.venue-hero__top {
  position: relative;
  display: flex;
  align-items: center;
}

.venue-hero__badge {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
}

.venue-hero__info {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.venue-hero__name {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
  word-break: break-all;
}

.venue-hero__meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.venue-hero__meta-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}

.venue-hero__meta-item text {
  margin-left: 6rpx;
}

.venue-hero__call {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #fff;
  font-size: 24rpx;
  color: #d31027;
  font-weight: 500;
}

.venue-hero__call text {
  margin-left: 6rpx;
}

.venue-hero__call--hover {
  opacity: 0.82;
}

.venue-hero__stats {
  position: relative;
  display: flex;
  align-items: stretch;
  margin-top: 26rpx;
  padding: 20rpx 0 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.venue-stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.venue-stat__label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.4;
}

.venue-stat__value {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
  text-align: center;
  word-break: break-all;
}

.venue-stat__split {
  width: 1rpx;
  margin: 6rpx 0;
  background: rgba(255, 255, 255, 0.22);
}

/* ---------- 标签页内容区 ---------- */
.tab-pane {
  background: #f6f7f9;
  padding-bottom: 24rpx;
}

/* ---------- 内容卡片 ---------- */
.content-card {
  margin: 24rpx 24rpx 0;
  padding: 8rpx 28rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 35, 41, 0.05);
}

.card-head {
  display: flex;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.card-head__bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #e63c4c, #d31027);
  margin-right: 14rpx;
}

.card-head__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

/* ---------- 简介正文 ---------- */
.summary-body {
  padding-top: 16rpx;
  font-size: 30rpx;
  color: #3b3a39;
  line-height: 1.9;
}

.summary-note {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #eceef1;
  font-size: 22rpx;
  color: #8c9097;
  line-height: 1.5;
}

.summary-note text {
  margin-left: 8rpx;
}

.empty-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 0;
}

/* ---------- 登记信息：两列栅格 ---------- */
.reg-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.reg-cell {
  width: 50%;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  border-bottom: 1rpx solid #f2f3f5;
}

.reg-cell:nth-child(odd) {
  padding-right: 20rpx;
}

.reg-cell:nth-child(even) {
  padding-left: 20rpx;
  border-left: 1rpx solid #f2f3f5;
}

.reg-cell__label {
  font-size: 24rpx;
  color: #969799;
  line-height: 1.4;
}

.reg-cell__value {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #1f2329;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-all;
}

/* ---------- 登记信息：整行条目 ---------- */
.reg-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.reg-row--last {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.reg-row--hover {
  background-color: #fafbfc;
}

.reg-row__icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin: 2rpx 18rpx 0 0;
  border-radius: 16rpx;
  background: #fdf0f1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reg-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.reg-row__label {
  font-size: 24rpx;
  color: #969799;
  line-height: 1.4;
}

.reg-row__value {
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #1f2329;
  line-height: 1.55;
  word-break: break-all;
}

.reg-row__value--mono {
  font-family: Menlo, Consolas, 'Courier New', monospace;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

/* ---------- 空态 ---------- */
.tab-pane .ms-empty {
  padding: 60rpx 32rpx;
}
