/* 场所介绍页（全屏沉浸式，简介为视觉主角） */

.bgc {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 20%, #f1f2f4 60%);
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}

/* 状态栏渐隐蒙层：白色卡片滚过顶部时状态栏文字仍可辨认 */
.status-veil {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 900;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(211, 16, 39, 0.96) 0%,
    rgba(211, 16, 39, 0.82) 60%,
    rgba(211, 16, 39, 0) 100%
  );
}

/* 固定返回按钮 */
.nav-back {
  position: fixed;
  left: 24rpx;
  z-index: 901;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back--hover {
  background: rgba(255, 255, 255, 0.3);
}

/* ---------- 页头 ---------- */
.page-head {
  position: relative;
}

.title-box {
  position: relative;
  z-index: 1;
  padding-top: 20rpx;
  padding-bottom: 70rpx;
  padding-left: 40rpx;
  overflow: hidden;
}

.top-title {
  font-size: 56rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.25;
}

.top-title2 {
  font-size: 30rpx;
  color: rgba(239, 239, 239, 0.92);
  margin-top: 8rpx;
  max-width: 70vw;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-img-wrap {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  pointer-events: none;
}

.top-img {
  position: absolute;
  right: 0;
  top: 30rpx;
  opacity: 0.6;
  width: 300rpx;
}

.top-img-gezi {
  position: absolute;
  left: 400rpx;
  top: 0;
  width: 130rpx;
  opacity: 0.9;
}

/* ---------- 白色内容区 ---------- */
.sheet {
  position: relative;
  z-index: 1;
  min-height: 60vh;
  padding: 28rpx 24rpx 40rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  background: #f6f7f9;
  border-radius: 28rpx 28rpx 0 0;
}

.sheet-state {
  padding: 100rpx 0;
}

/* ---------- 场所概况卡 ---------- */
.content-card {
  margin: 0 0 24rpx;
  padding: 30rpx 28rpx 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 35, 41, 0.05);
}

.venue-top {
  display: flex;
  align-items: center;
}

.venue-top__body {
  flex: 1;
  min-width: 0;
}

.venue-top__name {
  font-size: 38rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.4;
  word-break: break-all;
}

.venue-top__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.venue-top__tag {
  display: flex;
  align-items: center;
  margin: 0 14rpx 12rpx 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #eef0f3;
  font-size: 22rpx;
  color: #646566;
  line-height: 1.5;
}

.venue-top__call {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin-left: 20rpx;
  border-radius: 30rpx;
  background: #fdf0f1;
  font-size: 24rpx;
  color: #d31027;
  font-weight: 500;
}

.venue-top__call text {
  margin-left: 6rpx;
}

.venue-top__call--hover {
  opacity: 0.82;
}

/* ---------- 简介卡：视觉主角 ---------- */
.summary-card {
  position: relative;
  margin: 0 0 24rpx;
  padding: 60rpx 44rpx 36rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}

/* 装饰引号：低饱和浅红，置于卡片左上 */
.summary-quote {
  position: absolute;
  top: 2rpx;
  left: 28rpx;
  font-size: 140rpx;
  line-height: 1;
  color: rgba(211, 16, 39, 0.1);
  font-family: Georgia, 'Times New Roman', serif;
  pointer-events: none;
}

.summary-title {
  position: relative;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.4;
  padding-left: 26rpx;
}

/* 标题左侧竖线装饰 */
.summary-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 8rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #e63c4c, #d31027);
}

/* 标题下方短分隔线：留白节奏 */
.summary-rule {
  width: 88rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #eceef1;
  margin: 22rpx 0 34rpx;
}

.summary-body {
  position: relative;
  padding-top: 4rpx;
  font-size: 30rpx;
  color: #3b3a39;
  line-height: 1.9;
  word-break: break-word;
}

.summary-note {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed #eceef1;
  font-size: 22rpx;
  color: #8c9097;
  line-height: 1.5;
}

.summary-note text {
  margin-left: 8rpx;
}

/* ---------- 空态 ---------- */
.content-card .ms-empty {
  padding: 40rpx 0 20rpx;
}
