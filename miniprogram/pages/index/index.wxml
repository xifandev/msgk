<view class="bgc"></view>

<!-- 全屏沉浸式：仅覆盖状态栏的渐隐蒙层，保证状态栏文字在滚动后依然可读 -->
<view class="status-veil" style="height:{{ statusBarHeight }}px"></view>

<!-- 顶部安全区：状态栏 + 胶囊按钮行，按机型动态预留 -->
<view class="page-head" style="padding-top:{{ safeTop }}px">
  <view class="top-img-wrap" style="top:{{ safeTop }}px">
    <image class="top-img" src="/assets/images/xing5.png" mode="widthFix" />
    <image class="top-img-gezi" src="/assets/images/gezi.png" mode="widthFix" />
  </view>
  <view class="title-box">
    <view class="top-title">码上公开</view>
    <view class="top-title2">场所信息透明化，权益保障零距离！</view>
  </view>
</view>

<ms-cell-group inset>
  <view
    class="venue-selector {{ venueName ? '' : 'venue-selector--empty' }}"
    bind:tap="openVenueSelect"
    hover-class="venue-selector--hover"
    hover-stay-time="80"
    aria-role="button"
    aria-label="{{ venueName ? '切换场所，当前为' + venueName : '请选择场所' }}"
  >
    <view class="venue-selector__main">
      <view wx:if="{{ venueName }}" class="venue-selector__label">当前场所</view>
      <view class="venue-selector__name">{{ venueName || '点击选择场所' }}</view>
    </view>
    <view class="venue-selector__action">
      <text>{{ venueName ? '切换' : '选择' }}</text>
      <ms-icon class="venue-selector__arrow" name="arrow" size="24rpx" color="#d31027" />
    </view>
  </view>

  <view class="venue-divider"></view>
  <view class="grid-gap"></view>
  <ms-grid column-num="4" class="grid-4">
    <ms-grid-item bind:click="navigate" data-url="/pages/venue/venue" data-need-venue="{{ true }}">
      <view class="icon-size icon-changsuo">
        <ms-icon name="location" size="58rpx" color="#ffffff" />
      </view>
      <view class="app-title-top">场所介绍</view>
    </ms-grid-item>
    <ms-grid-item bind:click="navigate" data-url="/pages/personnel/personnel" data-need-venue="{{ true }}">
      <view class="icon-size icon-renyuan">
        <ms-icon name="manager" size="58rpx" color="#ffffff" />
      </view>
      <view class="app-title-top">人员公开</view>
    </ms-grid-item>
    <ms-grid-item bind:click="navigate" data-url="/pages/safety/safety" data-need-venue="{{ true }}">
      <view class="icon-size icon-red">
        <ms-icon name="bell" size="56rpx" color="#ffffff" />
      </view>
      <view class="app-title-top">场所安全</view>
    </ms-grid-item>
    <ms-grid-item bind:click="navigate" data-url="/pages/register/register" data-need-venue="{{ true }}">
      <view class="icon-size icon-lan">
        <ms-icon name="id-card" size="58rpx" color="#ffffff" />
      </view>
      <view class="app-title-top">注册信息</view>
    </ms-grid-item>
  </ms-grid>
</ms-cell-group>

<view class="block-gap"></view>

<ms-cell-group inset>
  <ms-grid column-num="2" direction="horizontal">
    <ms-grid-item bind:click="navigate" data-url="/pages/finance/finance" data-need-venue="{{ true }}">
      <view class="icon-size icon-huang">
        <ms-icon name="balance-pay" size="64rpx" color="#ffffff" />
      </view>
      <view class="app-box">
        <view class="app-title">财务公开</view>
        <view class="app-title2">收支信息透明化</view>
      </view>
    </ms-grid-item>
    <ms-grid-item bind:click="navigate" data-url="/pages/news/news">
      <view class="icon-size icon-shouzhi">
        <ms-icon name="column" size="64rpx" color="#ffffff" />
      </view>
      <view class="app-box">
        <view class="app-title">政策法规</view>
        <view class="app-title2">学习最新政策</view>
      </view>
    </ms-grid-item>
  </ms-grid>
</ms-cell-group>

<view class="block-gap"></view>

<ms-cell-group inset>
  <view class="news-section-head">
    <view class="news-section-accent"></view>
    <text class="news-section-title">最新动态</text>
  </view>
  <view class="tab-content">
      <ms-empty wx:if="{{ itemsLoaded && items.length === 0 }}" description="暂无公告" />
      <view wx:else>
        <view wx:for="{{ items }}" wx:key="id">
          <view
            class="news-item"
            bind:tap="openItem"
            data-kind="{{ item.kind }}"
            data-id="{{ item.id }}"
            hover-class="news-item--hover"
            hover-stay-time="80"
          >
            <view class="news-thumb">
              <ms-icon name="newspaper" size="52rpx" color="#d31027" />
            </view>
            <view class="news-content">
              <view class="news-title">{{ item.title }}</view>
              <view class="news-meta">
                <text class="news-kind">{{ item.category }}</text>
                <text class="news-date">{{ item.date }}</text>
              </view>
            </view>
            <ms-icon class="news-arrow" name="arrow" size="22rpx" color="#c8c9cc" />
          </view>
          <view wx:if="{{ index < items.length - 1 }}" class="news-hairline"></view>
        </view>
        <view
          wx:if="{{ items.length === 10 }}"
          class="news-more"
          bind:tap="navigate"
          data-url="/pages/news/news"
          hover-class="news-more--hover"
          hover-stay-time="80"
          aria-role="button"
          aria-label="查看更多政策法规"
        >
          <text>查看更多</text>
          <ms-icon name="arrow" size="22rpx" color="#969799" />
        </view>
      </view>
  </view>
</ms-cell-group>

<view class="foot-title">
  <view
    class="foot-support"
    hover-class="foot-support--hover"
    hover-stay-time="80"
    bind:tap="openCompany"
    aria-role="button"
    aria-label="查看技术支持联系方式"
  >
    <text class="foot-support__text">技术支持：山东盖特网络有限公司</text>
    <view class="foot-support__arrow">
      <ms-icon name="arrow" size="20rpx" color="#969799" />
    </view>
  </view>
</view>

<!-- 场所选择（全屏） -->
<ms-popup
  show="{{ venuePopup }}"
  position="bottom"
  custom-style="height:100vh;max-height:100vh;border-radius:0;padding-bottom:0;overflow:hidden;"
  bind:close="closeVenuePopup"
>
  <view class="venue-sheet">
    <view class="venue-sheet__head">
      <view class="venue-sheet__title">请选择场所</view>
      <view
        class="venue-sheet__close"
        hover-class="venue-sheet__close--hover"
        bind:tap="closeVenuePopup"
        aria-role="button"
        aria-label="关闭选择场所"
      >
        <ms-icon name="cross" size="34rpx" color="#646566" />
      </view>
    </view>

    <view class="venue-sheet__search">
      <ms-icon name="search" size="32rpx" color="#969799" />
      <input
        class="venue-sheet__input"
        value="{{ venueKeyword }}"
        placeholder="搜索场所名称或乡镇"
        placeholder-class="venue-sheet__placeholder"
        confirm-type="search"
        bindinput="onVenueSearch"
      />
      <view
        wx:if="{{ venueKeyword }}"
        class="venue-sheet__clear"
        bind:tap="clearVenueSearch"
        aria-role="button"
        aria-label="清空搜索"
      >
        <ms-icon name="cross" size="20rpx" color="#ffffff" />
      </view>
    </view>

    <view class="venue-sheet__body">
      <view wx:if="{{ venueTree.length === 0 }}" class="venue-sheet__loading">
        <ms-loading text="正在加载场所" color="#d31027" size="48rpx" />
      </view>
      <scroll-view wx:elif="{{ venueKeyword }}" class="venue-sheet__results" scroll-y>
        <view wx:if="{{ venueResults.length === 0 }}" class="venue-sheet__empty">
          <text>没有匹配的场所</text>
          <text class="venue-sheet__empty-tip">换个关键词试试，或清空搜索按乡镇浏览</text>
        </view>
        <view
          wx:for="{{ venueResults }}"
          wx:key="id"
          class="venue-sheet__result {{ item.id == activeVenueId ? 'is-active' : '' }}"
          data-id="{{ item.id }}"
          data-name="{{ item.name }}"
          bind:tap="onVenueResultSelect"
          hover-class="venue-sheet__result--hover"
        >
          <view class="venue-sheet__result-main">
            <text class="venue-sheet__result-name">{{ item.name }}</text>
            <text class="venue-sheet__result-town">{{ item.township }}</text>
          </view>
          <ms-icon wx:if="{{ item.id == activeVenueId }}" name="checked" size="32rpx" color="#d31027" />
        </view>
        <view class="venue-sheet__result-end" wx:if="{{ venueResults.length >= 50 }}">仅显示前 50 条，请细化关键词</view>
      </scroll-view>
      <ms-tree-select
        wx:else
        class="venue-sheet__tree"
        items="{{ venueTree }}"
        main-active-index="{{ venueNav }}"
        active-id="{{ activeVenueId }}"
        height="{{ 0 }}"
        bind:clicknav="onVenueNav"
        bind:clickitem="onVenueSelect"
      />
    </view>
  </view>
</ms-popup>

<!-- 技术支持 -->
<ms-action-sheet show="{{ companyShow }}" show-header="{{ false }}" title="软件技术支持" bind:close="closeCompany">
  <view class="support">
    <view class="support__intro">使用过程中遇到技术问题，可添加技术人员微信协助处理。</view>

    <view class="support__card" hover-class="support__card--hover" bind:tap="copyCompany">
      <view class="support__card-icon">
        <ms-icon name="phone" size="40rpx" color="#ffffff" />
      </view>
      <view class="support__card-main">
        <text class="support__card-label">技术支持微信</text>
        <text class="support__card-phone">152 2449 9331</text>
      </view>
      <view class="support__card-action">
        <text class="support__card-action-text">复制</text>
        <ms-icon name="arrow" size="22rpx" color="#d31027" />
      </view>
    </view>

    <view class="support__foot">
      <view class="support__foot-icon">
        <ms-icon name="bulb-o" size="26rpx" color="#969799" />
      </view>
      <text class="support__foot-text">复制后打开微信搜索添加好友，并说明使用场所与问题现象，便于快速处理。</text>
    </view>
  </view>
</ms-action-sheet>
