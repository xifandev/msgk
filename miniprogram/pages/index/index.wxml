<view class="bgc"></view>

<!-- 全屏沉浸式：仅覆盖状态栏的渐隐蒙层，保证状态栏文字在滚动后依然可读 -->
<view class="status-veil" style="height:{{ statusBarHeight }}px"></view>

<!-- 顶部安全区：状态栏 + 胶囊按钮行，按机型动态预留 -->
<view class="page-head" style="padding-top:{{ safeTop }}px">
  <view class="top-img-wrap" style="top:{{ safeTop }}px">
    <image class="top-img" src="/assets/images/xing5.png" mode="widthFix" />
    <image class="top-img-gezi" src="/assets/images/gezi.png" mode="widthFix" />
  </view>
  <view class="title-box">
    <view class="top-title">码上公开</view>
    <view class="top-title2">场所信息透明化，权益保障零距离！</view>
  </view>
</view>

<ms-cell-group inset>
  <view class="card-all">
    <view class="bian-box">
      <view class="card-bian" wx:if="{{ showCard }}">
        <view class="yezhuxinxi">
          <view class="card-xiaoqu-title" bind:tap="openVenueSelect">
            <text>{{ venueName || '点击选择场所' }}</text>
            <ms-icon
              class="{{ venueName ? 'card-xiaoqu-qiehuan' : 'card-xiaoqu-denglu' }}"
              name="{{ venueName ? 'sort' : 'arrow-up' }}"
              size="28rpx"
              color="#333333"
            />
          </view>
        </view>
      </view>
    </view>
    <view class="yuan-box">
      <view class="card-yuan"></view>
    </view>
  </view>

  <view class="grid-gap"></view>
  <ms-grid column-num="3">
    <ms-grid-item bind:click="navigate" data-url="/pages/venue/venue" data-need-venue="{{ true }}">
      <view class="icon-baoxiu">
        <image class="icon-baoxiu-img" src="/assets/images/changsuo.png" mode="aspectFit" />
      </view>
      <view class="app-title-top">场所介绍</view>
    </ms-grid-item>
    <ms-grid-item bind:click="navigate" data-url="/pages/personnel/personnel" data-need-venue="{{ true }}">
      <view class="icon-size icon-renyuan">
        <ms-icon name="manager" size="52rpx" color="#ffffff" />
      </view>
      <view class="app-title-top">人员公开</view>
    </ms-grid-item>
    <ms-grid-item bind:click="navigate" data-url="/pages/safety/safety" data-need-venue="{{ true }}">
      <view class="icon-size icon-red">
        <ms-icon name="bell" size="52rpx" color="#ffffff" />
      </view>
      <view class="app-title-top">场所安全</view>
    </ms-grid-item>
  </ms-grid>
</ms-cell-group>

<view class="block-gap"></view>

<ms-cell-group inset>
  <ms-grid column-num="2" direction="horizontal">
    <ms-grid-item bind:click="navigate" data-url="/pages/finance/finance" data-need-venue="{{ true }}">
      <view class="icon-size icon-huang">
        <ms-icon name="balance-pay" size="52rpx" color="#ffffff" />
      </view>
      <view class="app-box">
        <view class="app-title">财务公开</view>
        <view class="app-title2">收支信息透明化</view>
      </view>
    </ms-grid-item>
    <ms-grid-item bind:click="navigate" data-url="/pages/news/news">
      <view class="icon-size icon-shouzhi">
        <ms-icon name="column" size="52rpx" color="#ffffff" />
      </view>
      <view class="app-box">
        <view class="app-title">政策法规</view>
        <view class="app-title2">学习最新政策</view>
      </view>
    </ms-grid-item>
  </ms-grid>
</ms-cell-group>

<view class="block-gap"></view>

<ms-cell-group inset>
  <ms-tabs tabs="{{ ['最新动态'] }}" active="{{ 0 }}">
    <view class="tab-content">
      <ms-empty wx:if="{{ itemsLoaded && items.length === 0 }}" description="暂无公告" />
      <view wx:else>
        <view wx:for="{{ items }}" wx:key="id">
          <view
            class="news-item"
            bind:tap="openItem"
            data-kind="{{ item.kind }}"
            data-id="{{ item.id }}"
            hover-class="news-item--hover"
            hover-stay-time="80"
          >
            <view class="news-thumb">
              <ms-icon name="newspaper" size="40rpx" color="#d31027" />
            </view>
            <view class="news-content">
              <view class="news-title">{{ item.title }}</view>
              <view class="news-meta">
                <text class="news-kind">{{ item.kindText }}</text>
                <text class="news-date">{{ item.date }}</text>
              </view>
            </view>
            <ms-icon class="news-arrow" name="arrow" size="22rpx" color="#c8c9cc" />
          </view>
          <view wx:if="{{ index < items.length - 1 }}" class="news-hairline"></view>
        </view>
      </view>
    </view>
  </ms-tabs>
</ms-cell-group>

<view class="foot-title">
  <view>当前版本号：{{ version }}</view>
  <view bind:tap="openCompany">技术支持：山东盖特网络有限公司</view>
</view>

<!-- 场所选择（全屏） -->
<ms-popup
  show="{{ venuePopup }}"
  position="bottom"
  custom-style="height:100vh;max-height:100vh;border-radius:0;padding-bottom:0;overflow:hidden;"
  bind:close="closeVenuePopup"
>
  <view class="venue-sheet">
    <view class="venue-sheet__head">
      <view class="venue-sheet__title">请选择场所</view>
      <view
        class="venue-sheet__close"
        hover-class="venue-sheet__close--hover"
        bind:tap="closeVenuePopup"
        aria-role="button"
        aria-label="关闭选择场所"
      >
        <ms-icon name="cross" size="34rpx" color="#646566" />
      </view>
    </view>

    <view class="venue-sheet__search">
      <ms-icon name="search" size="32rpx" color="#969799" />
      <input
        class="venue-sheet__input"
        value="{{ venueKeyword }}"
        placeholder="搜索场所名称或乡镇"
        placeholder-class="venue-sheet__placeholder"
        confirm-type="search"
        bindinput="onVenueSearch"
      />
      <view
        wx:if="{{ venueKeyword }}"
        class="venue-sheet__clear"
        bind:tap="clearVenueSearch"
        aria-role="button"
        aria-label="清空搜索"
      >
        <ms-icon name="cross" size="20rpx" color="#ffffff" />
      </view>
    </view>

    <view class="venue-sheet__body">
      <view wx:if="{{ venueTree.length === 0 }}" class="venue-sheet__loading">
        <ms-loading text="正在加载场所" color="#d31027" size="48rpx" />
      </view>
      <scroll-view wx:elif="{{ venueKeyword }}" class="venue-sheet__results" scroll-y>
        <view wx:if="{{ venueResults.length === 0 }}" class="venue-sheet__empty">
          <text>没有匹配的场所</text>
          <text class="venue-sheet__empty-tip">换个关键词试试，或清空搜索按乡镇浏览</text>
        </view>
        <view
          wx:for="{{ venueResults }}"
          wx:key="id"
          class="venue-sheet__result {{ item.id == activeVenueId ? 'is-active' : '' }}"
          data-id="{{ item.id }}"
          data-name="{{ item.name }}"
          bind:tap="onVenueResultSelect"
          hover-class="venue-sheet__result--hover"
        >
          <view class="venue-sheet__result-main">
            <text class="venue-sheet__result-name">{{ item.name }}</text>
            <text class="venue-sheet__result-town">{{ item.township }}</text>
          </view>
          <ms-icon wx:if="{{ item.id == activeVenueId }}" name="checked" size="32rpx" color="#d31027" />
        </view>
        <view class="venue-sheet__result-end" wx:if="{{ venueResults.length >= 50 }}">仅显示前 50 条，请细化关键词</view>
      </scroll-view>
      <ms-tree-select
        wx:else
        class="venue-sheet__tree"
        items="{{ venueTree }}"
        main-active-index="{{ venueNav }}"
        active-id="{{ activeVenueId }}"
        height="{{ 0 }}"
        bind:clicknav="onVenueNav"
        bind:clickitem="onVenueSelect"
      />
    </view>
  </view>
</ms-popup>

<!-- 技术支持 -->
<ms-action-sheet show="{{ companyShow }}" title="软件技术支持" bind:close="closeCompany">
  <view class="gongsi-content">
    <ms-cell-group inset>
      <ms-cell
        title="开发公司"
        label="山东盖特网络有限公司，由沂水县共青团组织的支持下成立，公司以“专注软件开发”为宗旨，不断探索创新、为社会提供高效可靠的软件解决方案。"
      />
      <ms-cell title="联系电话" value="15224499331" border="{{ false }}" is-link bind:click="callCompany" />
    </ms-cell-group>
    <view class="contact-text">有任何软件问题，可以电话联系我们。</view>
  </view>
</ms-action-sheet>
