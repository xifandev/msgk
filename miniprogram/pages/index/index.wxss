.bgc {
  background: linear-gradient(180deg, #d31027, #f1f2f4 60%);
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}

.title-box {
  position: relative;
}

.top-title {
  font-size: 56rpx;
  color: #fff;
  padding-top: 40rpx;
  margin-left: 40rpx;
  font-weight: bold;
}

.top-title2 {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
  margin-left: 40rpx;
}

.top-img-box {
  width: 100vw;
  position: relative;
  min-height: 120rpx;
}

.top-img {
  width: 220rpx;
  position: absolute;
  right: 40rpx;
  top: -140rpx;
  opacity: 0.9;
}

.top-img-gezi {
  width: 160rpx;
  position: absolute;
  right: 220rpx;
  top: -60rpx;
  opacity: 0.5;
}

.card-all {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 0;
}

.card-venue {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #323233;
}

.card-venue-icon {
  margin-left: 12rpx;
  color: #d31027;
}

.card-yuan-box {
  display: flex;
  align-items: center;
}

.card-yuan {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #ea384d, #b31217);
}

.grid-gap {
  height: 40rpx;
}

.grid-img {
  width: 72rpx;
  height: 72rpx;
}

.grid-icon {
  font-size: 72rpx;
  line-height: 1;
}

.grid-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #323233;
}

.grid2-box {
  margin-left: 20rpx;
}

.grid2-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #323233;
}

.grid2-sub {
  font-size: 24rpx;
  color: #969799;
  margin-top: 6rpx;
}

.icon-renyuan {
  color: #1989fa;
}

.icon-anquan {
  color: #d31027;
}

.icon-caiwu {
  color: #ff9f18;
}

.icon-fagui {
  color: #07c060;
}

.block-gap {
  height: 25rpx;
}

.news-head {
  font-size: 32rpx;
  font-weight: bold;
  padding: 26rpx 32rpx 10rpx;
}

.news-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.news-content {
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
}

.news-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #3b3a39;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.news-time {
  color: #b9b9b9;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.news-kind {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.kind-safety {
  color: #d31027;
  background: rgba(211, 16, 39, 0.08);
}

.kind-notice {
  color: #ed6a0c;
  background: rgba(237, 106, 12, 0.08);
}

.kind-news {
  color: #1989fa;
  background: rgba(25, 137, 250, 0.08);
}

.foot-title {
  text-align: center;
  color: #969799;
  font-size: 24rpx;
  padding: 40rpx 0 60rpx;
  line-height: 1.8;
}

.popup-box {
  padding: 30rpx 0 50rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  padding-bottom: 20rpx;
}

.popup-loading {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
