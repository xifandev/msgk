.bgc {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 20%, #f1f2f4 60%);
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}

/* ---------- 全屏沉浸式顶部 ---------- */
/* 状态栏渐隐蒙层：高度由 JS 按机型注入，滚动后白色卡片经过时状态栏文字仍可辨认 */
.status-veil {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 900;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(211, 16, 39, 0.96) 0%,
    rgba(211, 16, 39, 0.82) 60%,
    rgba(211, 16, 39, 0) 100%
  );
}

.page-head {
  position: relative;
}

/* ---------- 页头 ---------- */
.title-box {
  position: relative;
  z-index: 1;
  padding-top: 24rpx;
  padding-bottom: 50rpx;
  padding-left: 40rpx;
  overflow: hidden;
}

.top-title {
  font-size: 68rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.25;
}

.top-title2 {
  font-size: 35rpx;
  color: rgba(239, 239, 239, 1);
  margin-top: 6rpx;
}

.top-img-wrap {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  pointer-events: none;
}

.top-img {
  position: absolute;
  right: 0;
  top: 30rpx;
  opacity: 0.6;
  width: 300rpx;
}

.top-img-gezi {
  position: absolute;
  left: 400rpx;
  top: 0;
  width: 130rpx;
  opacity: 0.9;
}

/* ---------- 场所卡片 ---------- */
.card-all {
  position: relative;
  height: 170rpx;
}

.bian-box {
  position: absolute;
  top: 0;
  left: 0;
  background-color: #fff;
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  overflow: hidden;
}

.card-bian {
  z-index: 91;
  position: absolute;
  top: 25rpx;
  width: 93%;
  height: 100%;
  border: 1px solid rgba(211, 16, 39, 0.18);
  border-bottom: 0;
  border-radius: 15rpx 15rpx 0 0;
  animation: ups 0.8s ease;
}

@keyframes ups {
  0% {
    transform: translateY(100%);
  }
  100% {
    transform: translateY(0);
  }
}

.yezhuxinxi {
  text-align: center;
}

.card-xiaoqu-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  color: #333333;
  margin-top: 60rpx;
  font-size: 34rpx;
  line-height: 1.4;
}

.card-xiaoqu-qiehuan,
.card-xiaoqu-denglu {
  margin-left: 12rpx;
  margin-top: -2rpx;
}

.card-xiaoqu-denglu {
  margin-left: 6rpx;
}

.yuan-box {
  z-index: 10;
  display: flex;
  align-items: center;
  flex-direction: column;
  background-color: #fff;
  position: absolute;
  top: 0;
  height: 230rpx;
  width: 100%;
  overflow: hidden;
}

.card-yuan {
  border-radius: 50%;
  position: absolute;
  top: 40rpx;
  width: 130vw;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 50%, rgba(255, 36, 36, 0.16) 100%);
}

.grid-gap {
  height: 55rpx;
}

.block-gap {
  height: 25rpx;
}

/* ---------- 宫格 ---------- */
.icon-size {
  width: 90rpx;
  height: 90rpx;
  border-radius: 25%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 四列宫格：图标与文字整体收小，避免挤压 */
.grid-4 .icon-size {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24%;
}

.grid-4 .icon-baoxiu {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24%;
}

.grid-4 .icon-baoxiu-img {
  width: 52rpx;
  height: 52rpx;
}

.grid-4 .app-title-top {
  padding-top: 8rpx;
  font-size: 26rpx;
  color: #333333;
}

.icon-baoxiu {
  width: 90rpx;
  height: 90rpx;
  border-radius: 25%;
  background: linear-gradient(180deg, #1acb80 0%, #36e498 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-baoxiu-img {
  width: 60rpx;
  height: 60rpx;
}

.icon-red {
  background: linear-gradient(180deg, #ff7359 0%, #fa9e8e 100%);
}

.icon-huang {
  background: linear-gradient(180deg, #ff9b2d 0%, #ffb556 100%);
}

.icon-shouzhi {
  background: linear-gradient(180deg, #30bb59 0%, #30bb59 100%);
}

.icon-renyuan {
  background: linear-gradient(180deg, #31b380 0%, #31b380 100%);
}

.icon-lan {
  background: linear-gradient(180deg, #4f8fd0 0%, #6ba7db 100%);
}

.app-title-top {
  padding-top: 10rpx;
  font-size: 29rpx;
  color: #333333;
}

.app-box {
  margin-left: 20rpx;
}

.app-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}

.app-title2 {
  font-size: 24rpx;
  color: #7b7b7c;
  line-height: 1.5;
}

/* ---------- 最新动态 ---------- */
.tab-content {
  background-color: #fff;
  padding: 14rpx 32rpx 20rpx;
}

.news-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.news-item--hover {
  background-color: #fafafa;
}

/* 行首报纸图标：浅红底 + 品牌红图标，作为文章的统一标识 */
.news-thumb {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fdf2f3 0%, #fbe7e9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.news-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.news-title {
  font-size: 31rpx;
  font-weight: 500;
  color: #2f2f2f;
  line-height: 1.5;
  overflow: hidden;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.news-kind {
  flex-shrink: 0;
  max-width: 280rpx;
  padding: 0 12rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 8rpx;
  background-color: #f4f5f7;
  color: #8a8d93;
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.news-date {
  margin-left: 14rpx;
  color: #b9b9b9;
  font-size: 24rpx;
}

.news-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 行分隔线：与标题左边缘对齐，右侧通栏 */
.news-hairline {
  height: 1rpx;
  margin-left: 110rpx;
  background-color: #f0f1f3;
  transform: scaleY(0.5);
}

/* ---------- 页脚 ---------- */
.foot-title {
  padding-top: 120rpx;
  padding-bottom: 60rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx);
  color: #999;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.9;
}

/* ---------- 场所选择（全屏） ---------- */
.venue-sheet {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #ffffff;
}

.venue-sheet__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 44rpx) 32rpx 8rpx;
  background: linear-gradient(to bottom, #f5f8fc, #ffffff);
}

.venue-sheet__title {
  flex: 1;
  min-width: 0;
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.3;
}

.venue-sheet__close {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.venue-sheet__close--hover {
  background-color: #e6e8eb;
}

.venue-sheet__search {
  display: flex;
  align-items: center;
  margin: 16rpx 32rpx 0;
  padding: 0 24rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background-color: #f5f6f8;
}

.venue-sheet__input {
  flex: 1;
  min-width: 0;
  margin: 0 14rpx;
  font-size: 28rpx;
  color: #323233;
}

.venue-sheet__placeholder {
  color: #b9bbbf;
}

.venue-sheet__clear {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background-color: #c8c9cc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.venue-sheet__body {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  border-top: 1rpx solid #f0f1f3;
  overflow: hidden;
}

.venue-sheet__tree {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.venue-sheet__loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.venue-sheet__results {
  flex: 1;
  min-height: 0;
}

.venue-sheet__result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid #f5f6f8;
}

.venue-sheet__result--hover {
  background-color: #f7f8fa;
}

.venue-sheet__result.is-active .venue-sheet__result-name {
  color: #d31027;
  font-weight: 500;
}

.venue-sheet__result-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.venue-sheet__result-name {
  display: block;
  font-size: 30rpx;
  color: #323233;
  line-height: 1.4;
  word-break: break-all;
}

.venue-sheet__result-town {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #969799;
}

.venue-sheet__result-end {
  padding: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b9bbbf;
}

.venue-sheet__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
  font-size: 28rpx;
  color: #646566;
}

.venue-sheet__empty-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #969799;
  text-align: center;
  line-height: 1.6;
}

/* ---------- 技术支持 ---------- */
.gongsi-content {
  padding: 20rpx 0 60rpx;
}

.contact-text {
  padding: 30rpx 48rpx 0;
  font-size: 28rpx;
  color: #646566;
  text-align: center;
  line-height: 1.6;
}
