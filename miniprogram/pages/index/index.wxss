.bgc {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 20%, #f1f2f4 60%);
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}

/* ---------- 页头 ---------- */
.title-box {
  position: relative;
  padding-bottom: 50rpx;
  padding-left: 40rpx;
  overflow: hidden;
}

.top-title {
  font-size: 68rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.25;
}

.top-title2 {
  font-size: 35rpx;
  color: rgba(239, 239, 239, 1);
  margin-top: 6rpx;
}

.top-img-wrap {
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100vw;
  pointer-events: none;
}

.top-img {
  position: absolute;
  right: 0;
  top: 30rpx;
  opacity: 0.6;
  width: 300rpx;
}

.top-img-gezi {
  position: absolute;
  left: 400rpx;
  top: 0;
  width: 130rpx;
  opacity: 0.9;
}

/* ---------- 场所卡片 ---------- */
.card-all {
  position: relative;
  height: 170rpx;
}

.bian-box {
  position: absolute;
  top: 0;
  left: 0;
  background-color: #fff;
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  overflow: hidden;
}

.card-bian {
  z-index: 91;
  position: absolute;
  top: 25rpx;
  width: 93%;
  height: 100%;
  border: 1px solid rgba(211, 16, 39, 0.18);
  border-bottom: 0;
  border-radius: 15rpx 15rpx 0 0;
  animation: ups 0.8s ease;
}

@keyframes ups {
  0% {
    transform: translateY(100%);
  }
  100% {
    transform: translateY(0);
  }
}

.yezhuxinxi {
  text-align: center;
}

.card-xiaoqu-title {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  color: #333333;
  margin-top: 60rpx;
  font-size: 34rpx;
  line-height: 1.4;
}

.card-xiaoqu-qiehuan,
.card-xiaoqu-denglu {
  margin-left: 12rpx;
  margin-top: -2rpx;
}

.card-xiaoqu-denglu {
  margin-left: 6rpx;
}

.yuan-box {
  z-index: 10;
  display: flex;
  align-items: center;
  flex-direction: column;
  background-color: #fff;
  position: absolute;
  top: 0;
  height: 230rpx;
  width: 100%;
  overflow: hidden;
}

.card-yuan {
  border-radius: 50%;
  position: absolute;
  top: 40rpx;
  width: 130vw;
  height: 200rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 50%, rgba(255, 36, 36, 0.16) 100%);
}

.grid-gap {
  height: 55rpx;
}

.block-gap {
  height: 25rpx;
}

/* ---------- 宫格 ---------- */
.icon-size {
  width: 90rpx;
  height: 90rpx;
  border-radius: 25%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-baoxiu {
  width: 90rpx;
  height: 90rpx;
  border-radius: 25%;
  background: linear-gradient(180deg, #1acb80 0%, #36e498 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-baoxiu-img {
  width: 60rpx;
  height: 60rpx;
}

.icon-red {
  background: linear-gradient(180deg, #ff7359 0%, #fa9e8e 100%);
}

.icon-huang {
  background: linear-gradient(180deg, #ff9b2d 0%, #ffb556 100%);
}

.icon-shouzhi {
  background: linear-gradient(180deg, #30bb59 0%, #30bb59 100%);
}

.icon-renyuan {
  background: linear-gradient(180deg, #31b380 0%, #31b380 100%);
}

.app-title-top {
  padding-top: 10rpx;
  font-size: 29rpx;
  color: #333333;
}

.app-box {
  margin-left: 20rpx;
}

.app-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}

.app-title2 {
  font-size: 24rpx;
  color: #7b7b7c;
  line-height: 1.5;
}

/* ---------- 最新动态 ---------- */
.tab-content {
  background-color: #fff;
  padding: 35rpx 32rpx 20rpx;
}

.news-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.news-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.news-title {
  font-size: 31rpx;
  color: #3b3a39;
  line-height: 1.5;
  max-height: 120rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  word-break: break-all;
}

.news-time {
  color: #b9b9b9;
  font-size: 28rpx;
}

/* ---------- 页脚 ---------- */
.foot-title {
  padding-top: 120rpx;
  padding-bottom: 100rpx;
  color: #999;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.9;
}

/* ---------- 场所选择弹层 ---------- */
.leixing-box {
  background: linear-gradient(to bottom, #f3f7fb, #ffffff);
  padding-bottom: 10rpx;
}

.leixing {
  font-size: 38rpx;
  width: 100%;
  text-align: center;
  padding-top: 30rpx;
  padding-bottom: 30rpx;
  color: #323233;
}

.venue-loading {
  height: 460px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-gap {
  height: 50rpx;
}

/* ---------- 技术支持 ---------- */
.gongsi-content {
  padding: 20rpx 0 60rpx;
}

.contact-text {
  padding: 30rpx 48rpx 0;
  font-size: 28rpx;
  color: #646566;
  text-align: center;
  line-height: 1.6;
}
