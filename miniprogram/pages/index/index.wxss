.bgc {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 20%, #f1f2f4 60%);
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}

/* ---------- 全屏沉浸式顶部 ---------- */
/* 状态栏渐隐蒙层：高度由 JS 按机型注入，滚动后白色卡片经过时状态栏文字仍可辨认 */
.status-veil {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 900;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(211, 16, 39, 0.96) 0%,
    rgba(211, 16, 39, 0.82) 60%,
    rgba(211, 16, 39, 0) 100%
  );
}

.page-head {
  position: relative;
}

/* ---------- 页头 ---------- */
.title-box {
  position: relative;
  z-index: 1;
  padding-top: 24rpx;
  padding-bottom: 50rpx;
  padding-left: 40rpx;
  overflow: hidden;
}

.top-title {
  font-size: 68rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.25;
}

.top-title2 {
  font-size: 35rpx;
  color: rgba(239, 239, 239, 1);
  margin-top: 6rpx;
}

.top-img-wrap {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  width: 100vw;
  pointer-events: none;
}

.top-img {
  position: absolute;
  right: 0;
  top: 30rpx;
  opacity: 0.6;
  width: 300rpx;
}

.top-img-gezi {
  position: absolute;
  left: 400rpx;
  top: 0;
  width: 130rpx;
  opacity: 0.9;
}

/* ---------- 当前场所选择条 ---------- */
.venue-selector {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
  background-color: #ffffff;
}

.venue-selector--hover {
  background-color: #fafafb;
}

/* 未选择场所：整块浅红底 + 红色加粗主文案，引导点击 */
.venue-selector--empty {
  background-color: #fdf3f3;
}

.venue-selector--empty.venue-selector--hover {
  background-color: #fbeaea;
}

.venue-selector--empty .venue-selector__name {
  margin-top: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #d31027;
}

.venue-selector__main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.venue-selector__label {
  font-size: 22rpx;
  color: #969799;
  line-height: 1.3;
}

.venue-selector__name {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #2f2f2f;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.venue-selector__action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background-color: #fdf3f3;
  font-size: 24rpx;
  color: #d31027;
}

/* 未选择时整块已是浅红底，操作按钮用白底保持可识别 */
.venue-selector--empty .venue-selector__action {
  background-color: #ffffff;
}

.venue-selector__arrow {
  margin-left: 4rpx;
}

.venue-divider {
  height: 1rpx;
  margin: 0 32rpx;
  background-color: #f0f1f3;
  transform: scaleY(0.5);
}

.grid-gap {
  height: 20rpx;
}

.block-gap {
  height: 25rpx;
}

/* ---------- 宫格 ---------- */
.icon-size {
  width: 108rpx;
  height: 108rpx;
  border-radius: 25%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 四列宫格：图标与文字整体收小，避免挤压 */
.grid-4 .icon-size {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24%;
}

.grid-4 .app-title-top {
  padding-top: 8rpx;
  font-size: 26rpx;
  color: #333333;
}

.icon-changsuo {
  background: linear-gradient(180deg, #1acb80 0%, #36e498 100%);
}

.icon-red {
  background: linear-gradient(180deg, #ff7359 0%, #fa9e8e 100%);
}

.icon-huang {
  background: linear-gradient(180deg, #ff9b2d 0%, #ffb556 100%);
}

.icon-shouzhi {
  background: linear-gradient(180deg, #30bb59 0%, #30bb59 100%);
}

.icon-renyuan {
  background: linear-gradient(180deg, #31b380 0%, #31b380 100%);
}

.icon-lan {
  background: linear-gradient(180deg, #4f8fd0 0%, #6ba7db 100%);
}

.app-title-top {
  padding-top: 10rpx;
  font-size: 29rpx;
  color: #333333;
}

.app-box {
  margin-left: 20rpx;
}

.app-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
}

.app-title2 {
  font-size: 24rpx;
  color: #7b7b7c;
  line-height: 1.5;
}

/* ---------- 最新动态 ---------- */
.news-section-head {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx 26rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f1f3;
}

.news-section-accent {
  width: 6rpx;
  height: 34rpx;
  margin-right: 16rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #ea384d 0%, #d31027 100%);
}

.news-section-title {
  color: #262626;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.tab-content {
  background-color: #fff;
  padding: 14rpx 32rpx 20rpx;
}

.news-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
}

.news-item--hover {
  background-color: #fafafa;
}

/* 行首报纸图标：浅红底 + 品牌红图标，作为文章的统一标识 */
.news-thumb {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fdf2f3 0%, #fbe7e9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.news-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.news-title {
  font-size: 31rpx;
  font-weight: 500;
  color: #2f2f2f;
  line-height: 1.5;
  overflow: hidden;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.news-kind {
  flex-shrink: 0;
  max-width: 280rpx;
  padding: 0 12rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 8rpx;
  background-color: #f4f5f7;
  color: #8a8d93;
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.news-date {
  margin-left: 14rpx;
  color: #b9b9b9;
  font-size: 24rpx;
}

.news-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 行分隔线：与标题左边缘对齐，右侧通栏 */
.news-hairline {
  height: 1rpx;
  margin-left: 110rpx;
  background-color: #f0f1f3;
  transform: scaleY(0.5);
}

.news-more {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  padding: 24rpx 0 12rpx;
  border-top: 1rpx solid #f0f1f3;
  font-size: 26rpx;
  color: #646566;
}

.news-more text {
  margin-right: 6rpx;
}

.news-more--hover {
  opacity: 0.6;
}

/* ---------- 页脚 ---------- */
.foot-title {
  padding-top: 120rpx;
  padding-bottom: 60rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx);
  text-align: center;
}

.foot-support {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e8e9ec;
  background: #ffffff;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.foot-support__text {
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0;
  color: #85868a;
}

.foot-support__arrow {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.foot-support--hover {
  background: #f7f8fa;
  border-color: #dcdee2;
}

/* ---------- 技术支持 ---------- */
.support {
  padding: 60rpx 40rpx 56rpx;
}

.support__intro {
  padding: 0 16rpx;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #646566;
  text-align: center;
}

.support__card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border: 1rpx solid #eeeff1;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.support__card--hover {
  background: #fafafb;
}

.support__card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #d31027;
}

.support__card-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.support__card-label {
  font-size: 24rpx;
  line-height: 1.4;
  color: #969799;
}

.support__card-phone {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 1rpx;
  color: #323233;
}

.support__card-action {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #fdeef0;
}

.support__card-action-text {
  margin-right: 6rpx;
  font-size: 24rpx;
  color: #d31027;
}

.support__foot {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-top: 28rpx;
  padding: 0 8rpx;
}

.support__foot-text {
  margin-left: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #969799;
  text-align: left;
}

.support__foot-icon {
  display: flex;
  flex-shrink: 0;
  margin-top: 6rpx;
}
