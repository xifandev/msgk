/* 财务公开：账单式设计 · 阳光绿主题（公开 / 明亮 / 通透）
   色彩：主色 #0a7d59，嫩绿 #35c885，浅绿底 #f4faf6；支出用暖沙色 #c98214 区分 */

.pane {
  background: #f4faf6;
  padding-bottom: 30rpx;
  min-height: 60vh;
}

/* 内容区、滚动区与标签页主体统一浅绿底，去掉说明文字下方的白色底块；
   不改 page-main 的 env(safe-area-inset-bottom) 外边距，继续保留 iPhone 底部安全区 */
.cellgroup,
.cellgroup__scroll,
.ms-tabs {
  background-color: #f4faf6;
}

.bottom-gap {
  height: 24rpx;
}

/* 吸顶标签栏与浅绿内容区之间靠色差分界，去掉组件自带的分隔线（addGlobalClass 已开启）；
   只留一层极淡的投影，内容滚到栏下方时才有层次，静止时几乎看不见 */
.ms-tabs.is-sticky .ms-tabs__nav {
  border-bottom: 0;
  box-shadow: 0 3rpx 10rpx rgba(6, 89, 63, 0.04);
}

/* ---------- 区块标题 ---------- */
.section {
  margin-top: 36rpx;
}

.section__head {
  display: flex;
  align-items: center;
  padding: 0 24rpx 14rpx;
}

.section__bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #35c885, #0a7d59);
  margin-right: 12rpx;
}

.section__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #17211c;
}

.section__extra {
  font-size: 24rpx;
  color: #7f8782;
}

/* ---------- 日期分组 ---------- */
.day {
  margin: 0 24rpx 20rpx;
}

.day__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.day__date {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4c545e;
  font-weight: 500;
}

.day__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #17a273;
  margin-right: 10rpx;
}

.day__card {
  background: #fff;
  border-radius: 20rpx;
  padding: 4rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
  overflow: hidden;
}

.bill {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}

.bill:last-child {
  border-bottom: none;
}

.bill__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bill__icon.is-income {
  background: linear-gradient(135deg, #1aab7c 0%, #0a7d59 100%);
}

.bill__icon.is-expense {
  background: linear-gradient(135deg, #f2b455 0%, #dd9a2b 100%);
}

/* 收/支用正负号区分，不只靠颜色 */
.bill__glyph {
  font-size: 40rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1;
  transform: translateY(-2rpx);
}

.bill__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 18rpx;
}

.bill__summary {
  font-size: 30rpx;
  color: #17211c;
  line-height: 1.5;
  word-break: break-all;
}

.bill__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7f8782;
}

.bill__amount {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.bill__amount.is-income {
  color: #0a7d59;
}

.bill__amount.is-expense {
  color: #17211c;
}

/* ---------- 账单卡（月度 / 年度共用） ---------- */
/* 深绿实地卡片，只承载三个数值结论：期末结余为主视觉，收入 / 支出在下沿分行对置。
   切换时间的入口收在标题行右侧，页面上不再单独占一条选择条。 */
.bill-card {
  position: relative;
  overflow: hidden;
  margin: 26rpx 24rpx 0;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(158deg, #1e8a60 0%, #0f6a45 55%, #0b4d33 100%);
  box-shadow: 0 18rpx 40rpx rgba(10, 84, 56, 0.18);
}

/* 右上角柔光：纯装饰，不承载信息 */
.bill-card__glow {
  position: absolute;
  top: -170rpx;
  right: -130rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 226, 168, 0.32) 0%, rgba(94, 226, 168, 0) 68%);
  pointer-events: none;
}

/* 标题行给固定行高与最小高度，标题与右侧按钮才有同一个垂直对齐基准 */
.bill-card__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
}

.bill-card__title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* 切换年份 / 切换月份：白底深绿字的实心胶囊，在深绿卡上作为明确的可点动作 */
.bill-card__switch {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  margin-left: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 12rpx rgba(4, 40, 26, 0.16);
}

.bill-card__switch--hover {
  background: #ffffff;
}

/* 行高固定为 1，文字不会在胶囊里被字体行距顶偏 */
.bill-card__switch-text {
  margin-right: 6rpx;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
  color: #0b5c3d;
}

/* 该月 / 该年没有公开账单：不摆一排 0.00，只留一句结论 */
.bill-card__empty {
  position: relative;
  margin-top: 44rpx;
  padding-bottom: 6rpx;
}

.bill-card__empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

.bill-card__hero {
  position: relative;
  margin-top: 48rpx;
}

.bill-card__hero-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 2rpx;
}

.bill-card__hero-value {
  display: block;
  margin-top: 16rpx;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: 1rpx;
  color: #edfff6;
  word-break: break-all;
}

/* 年结余为负时换成暖沙色，不只靠符号区分 */
.bill-card__hero-value.is-negative {
  color: #f7c98d;
}

.bill-card__flow {
  position: relative;
  display: flex;
  align-items: flex-end;
  margin-top: 42rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.bill-card__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bill-card__item--right {
  align-items: flex-end;
  text-align: right;
}

.bill-card__item-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 1rpx;
}

.bill-card__item-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.bill-card__item-value.is-income {
  color: #7fe3b4;
}

.bill-card__item-value.is-expense {
  color: #f6cd8e;
}

/* ---------- 月度明细卡 ---------- */
/* 卡片本身是抽屉入口：右侧给文字链接 + 箭头做可点提示，点按只加深投影，不整块变色 */
.month {
  margin: 0 24rpx 18rpx;
  padding: 22rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
  transition: box-shadow 0.16s ease;
}

.month--hover {
  box-shadow: 0 8rpx 22rpx rgba(6, 89, 63, 0.1);
}

.month__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #17211c;
}

.month__more {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
}

.month__more-text {
  margin-right: 6rpx;
  font-size: 23rpx;
  color: #8f939a;
}

.month__row {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
}

.mstat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 8rpx;
  text-align: center;
}

.mstat + .mstat {
  border-left: 1rpx solid #edf3ef;
}

.mstat__label {
  font-size: 23rpx;
  color: #7f8782;
}

.mstat__value {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #17211c;
  font-weight: 600;
  word-break: break-all;
}

.mstat__value.is-income {
  color: #0a7d59;
}

.mstat__value.is-expense {
  color: #c98214;
}

.mstat__value.is-negative {
  color: #9a5410;
}

/* ---------- 空态 / 骨架 / 说明 ---------- */
.empty-card {
  margin: 18rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.empty-card__hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9db2a7;
  line-height: 1.6;
  text-align: center;
}

.skeleton {
  margin: 20rpx 24rpx 0;
}

.skeleton__hero {
  height: 300rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #eef3f0 25%, #e4ece7 37%, #eef3f0 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

.skeleton__row {
  height: 96rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f4f7f5 25%, #eaf0ec 37%, #f4f7f5 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.notice {
  display: flex;
  align-items: flex-start;
  margin: 28rpx 28rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #edf7f1;
}

.notice__text {
  flex: 1;
  margin-left: 10rpx;
  font-size: 23rpx;
  color: #4d7f68;
  line-height: 1.6;
}

/* ---------- 月度明细抽屉 ----------
   结构：抓手 → 月份标题（左右切月）+ 该月合计 → 明细滚动区 → 口径说明。
   抽屉占屏 78vh，头部与合计固定，只有明细区滚动，来回切月时版面不跳动 */
.sheet {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

/* 抓手：同时是下拉关闭手柄。整块是 44rpx 高的透明命中区，横条用伪元素画，
   这样手指压在横条边缘也能触发拖动（不依赖子节点） */
.sheet__handle {
  flex-shrink: 0;
  width: 240rpx;
  height: 44rpx;
  margin: 8rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet__handle::after {
  content: '';
  width: 72rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d2e0d9;
}

.sheet__handle--hover::after {
  background: #b8cec3;
}

.sheet__head {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 96rpx 18rpx;
}

/* 左右切月：到达当前年份首末月后置灰且不再响应点按 */
.sheet__arrow {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e7f2ec;
}

.sheet__arrow.is-disabled {
  background: transparent;
}

.sheet__title-box {
  min-width: 0;
  margin: 0 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #17211c;
  letter-spacing: 0.5rpx;
}

.sheet__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7f8782;
}

.sheet__close {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet__close--hover {
  background: #e7f2ec;
}

/* 该月合计沿用月度页的三栏结构，口径与卡片上的数值保持一致 */
.sheet__summary {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  margin: 0 24rpx;
  padding: 20rpx 8rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
}

.sheet__scroll {
  flex: 1;
  min-height: 0;
  padding-top: 18rpx;
  box-sizing: border-box;
}

.sheet__empty {
  padding: 46rpx 24rpx 6rpx;
}

.sheet__notice {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 24rpx 30rpx;
}

.sheet__notice-text {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #6d8d7c;
}

.sheet__loading {
  flex: 1;
  min-height: 0;
  padding: 18rpx 24rpx 0;
}

.sheet__error {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 60rpx;
}

.sheet__error-text {
  font-size: 26rpx;
  color: #7f8782;
}

.sheet__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  border: 1rpx solid #b9dccb;
  font-size: 26rpx;
  color: #0a7d59;
}

.sheet__retry--hover {
  background: #e7f2ec;
}


/* ---------- 选择月份 / 选择年份弹窗 ---------- */
/* 只列该场所已公开的账期，点选即切换：chip 主文案是账期，副文案是公开状态 */
.periods {
  padding: 4rpx 28rpx 34rpx;
}

.periods__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 0 66rpx;
  font-size: 26rpx;
  color: #7f8782;
}

.periods__state-text {
  font-size: 26rpx;
  color: #7f8782;
}

.periods__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  border: 1rpx solid #b9dccb;
  font-size: 26rpx;
  color: #0a7d59;
}

.periods__retry--hover {
  background: #eef7f2;
}

.ps-years {
  display: flex;
  flex-wrap: wrap;
}

/* 年份 chip 一行两个，宽度随字数自适应 */
.ps-chip--year {
  min-width: 208rpx;
}

.ps-group + .ps-group {
  margin-top: 28rpx;
}

.ps-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.ps-group__year {
  font-size: 27rpx;
  font-weight: 600;
  color: #17211c;
}

.ps-group__count {
  font-size: 22rpx;
  color: #8f939a;
}

.ps-grid {
  display: flex;
  flex-wrap: wrap;
}

.ps-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 26rpx 12rpx;
  border: 1rpx solid #e6efe9;
  border-radius: 16rpx;
  background: #f8fbf9;
}

.ps-chip--hover {
  background: #eef7f2;
}

/* 当前账期用主色描边 + 主色文字标出，不只用底色区分 */
.ps-chip.is-active {
  border-color: #0a7d59;
  background: #e9f7ef;
}

.ps-chip.is-active .ps-chip__label {
  color: #0a7d59;
  font-weight: 600;
}

.ps-chip__label {
  font-size: 26rpx;
  color: #17211c;
  line-height: 1.4;
}

.ps-chip__tag {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #17a273;
  line-height: 1.4;
}
