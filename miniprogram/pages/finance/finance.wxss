/* 财务公开：对账单式设计 · 深底白卡（墨绿暗场 + 白色账单卡）
   色彩：暗场 #0f1613，主色 #0a7d59，浅点缀 #3d9b76 / 暖金 #d19a3f。
   版式原则：深色底托白卡 —— 卡片是舞台主角，细线与留白分层，色彩只做点缀 */

.pane {
  background: #0f1613;
  padding-bottom: 30rpx;
  min-height: 60vh;
}

/* 内容区、滚动区与标签页主体统一暗场底；不改 page-main 安全区外边距 */
.cellgroup,
.cellgroup__scroll,
.ms-tabs {
  background-color: #0f1613;
}

/* 暗场上的标签栏：未选中淡白灰，选中纯白（组件 active 色是内联样式，需 !important 覆盖） */
.ms-tabs__nav {
  background-color: transparent;
}

.ms-tabs__item {
  color: rgba(255, 255, 255, 0.55);
}

.ms-tabs__item.is-active {
  color: #ffffff !important;
}

.bottom-gap {
  height: 24rpx;
}

/* 吸顶标签栏与浅绿内容区之间靠色差分界，去掉组件自带的分隔线（addGlobalClass 已开启）；
   只留一层极淡的投影，内容滚到栏下方时才有层次，静止时几乎看不见 */
.ms-tabs.is-sticky .ms-tabs__nav {
  border-bottom: 0;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.25);
}

/* ---------- 区块标题 ---------- */
.section {
  margin-top: 36rpx;
}

.section__head {
  display: flex;
  align-items: center;
  padding: 0 24rpx 14rpx;
}

.section__bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #35c885, #0a7d59);
  margin-right: 12rpx;
}

.section__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #eef3ef;
}

.section__extra {
  font-size: 24rpx;
  color: #7e8a83;
}

/* ---------- 公开明细：月份分组信息流 ---------- */
/* 每个公开月份一组：顶部是月份标题 + 该月收支小结，下面是按日期分组的完整明细 */
.month-group {
  margin-top: 48rpx;
}

/* 月份头一行放下：标题与"共 N 笔"强制不换行，收/支统计收小，
   窄屏优先压缩统计列，不再把标题顶折行 */
.month-group__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
}

.month-group__title-box {
  display: flex;
  align-items: baseline;
  flex-shrink: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.month-group__title {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #f2f6f3;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.month-group__meta {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 21rpx;
  color: #7e8a83;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.month-group__sum {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
}

.month-group__sum-item {
  display: flex;
  align-items: baseline;
  white-space: nowrap;
}

.month-group__sum-item + .month-group__sum-item {
  margin-left: 18rpx;
}

/* 收/支只是小标签，数值用近白 —— 层级靠字重不靠颜色 */
.month-group__sum-label {
  margin-right: 6rpx;
  font-size: 20rpx;
  color: #6d7a73;
  letter-spacing: 1rpx;
}

.month-group__sum-label.is-income {
  color: #4fbf8f;
}

.month-group__sum-label.is-expense {
  color: #d19a3f;
}

.month-group__sum-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #eef3ef;
  letter-spacing: 0;
}

.month-group__empty {
  margin: 0 24rpx;
  padding: 34rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e8efea;
  border-radius: 24rpx;
  text-align: center;
}

.month-group__empty-text {
  font-size: 24rpx;
  color: #9db2a7;
}

/* ---------- 日期分组 ---------- */
/* 日期是小字标签 + 向右延伸的细线，像对账单的栏头，不再用圆点 */
.day {
  margin: 0 24rpx 24rpx;
}

.day__head {
  display: flex;
  align-items: center;
  padding: 0 10rpx 14rpx;
}

.day__date {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7e8a83;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.day__rule {
  flex: 1;
  height: 1rpx;
  margin-left: 18rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* 卡片改平面细边：投影只留一丝，靠留白和细线分层 */
.day__card {
  background: #fff;
  border: 1rpx solid #e8efea;
  border-radius: 24rpx;
  padding: 6rpx 28rpx;
  box-shadow: 0 1rpx 3rpx rgba(6, 89, 63, 0.03);
  overflow: hidden;
}

.bill {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

/* 行间细线从文字左侧起，不穿过标记圆 */
.bill::after {
  content: '';
  position: absolute;
  left: 64rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #eef2ef;
}

.bill:last-child::after {
  display: none;
}

/* 收/支标记：细边空心圆 + 正负号，取代原来的大色块图标 */
.bill__mark {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bill__mark.is-income {
  border: 1.5rpx solid #b7ddc9;
}

.bill__mark.is-expense {
  border: 1.5rpx solid #ecd9b8;
}

/* 收/支用正负号区分，不只靠颜色 */
.bill__glyph {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.bill__mark.is-income .bill__glyph {
  color: #0a7d59;
}

.bill__mark.is-expense .bill__glyph {
  color: #b97a10;
}

.bill__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
}

.bill__summary {
  font-size: 29rpx;
  color: #1b241f;
  line-height: 1.5;
  word-break: break-all;
}

.bill__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a918c;
  letter-spacing: 1rpx;
}

/* 金额列：¥ 缩小降色，数字放大加粗 —— 整行唯一的重音 */
.bill__amount {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: baseline;
}

.bill__currency {
  margin-right: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #9aa5a0;
}

.bill__value {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.bill__amount.is-income .bill__value {
  color: #0a7d59;
}

.bill__amount.is-expense .bill__value {
  color: #17211c;
}

/* ---------- 账单卡（月度 / 年度共用） ---------- */
/* 深绿实地卡片，只承载三个数值结论：期末结余为主视觉，收入 / 支出在下沿分行对置。
   切换时间的入口收在标题行右侧，页面上不再单独占一条选择条。 */
.bill-card {
  position: relative;
  overflow: hidden;
  margin: 26rpx 24rpx 0;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(158deg, #1e8a60 0%, #0f6a45 55%, #0b4d33 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.35);
}

/* 右上角柔光：纯装饰，不承载信息 */
.bill-card__glow {
  position: absolute;
  top: -170rpx;
  right: -130rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 226, 168, 0.32) 0%, rgba(94, 226, 168, 0) 68%);
  pointer-events: none;
}

/* 标题行给固定行高与最小高度，标题与右侧按钮才有同一个垂直对齐基准 */
.bill-card__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
}

.bill-card__title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* 切换年份：白底深绿字的实心胶囊，在深绿卡上作为明确的可点动作 */
.bill-card__switch {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  margin-left: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 12rpx rgba(4, 40, 26, 0.16);
}

.bill-card__switch--hover {
  background: #ffffff;
}

/* 行高固定为 1，文字不会在胶囊里被字体行距顶偏 */
.bill-card__switch-text {
  margin-right: 6rpx;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
  color: #0b5c3d;
}

/* 该月 / 该年没有公开账单：不摆一排 0.00，只留一句结论 */
.bill-card__empty {
  position: relative;
  margin-top: 44rpx;
  padding-bottom: 6rpx;
}

.bill-card__empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

.bill-card__hero {
  position: relative;
  margin-top: 48rpx;
}

.bill-card__hero-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 2rpx;
}

.bill-card__hero-value {
  display: block;
  margin-top: 16rpx;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: 1rpx;
  color: #edfff6;
  word-break: break-all;
}

/* 年结余为负时换成暖沙色，不只靠符号区分 */
.bill-card__hero-value.is-negative {
  color: #f7c98d;
}

.bill-card__flow {
  position: relative;
  display: flex;
  align-items: flex-end;
  margin-top: 42rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.bill-card__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bill-card__item--right {
  align-items: flex-end;
  text-align: right;
}

.bill-card__item-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 1rpx;
}

.bill-card__item-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.bill-card__item-value.is-income {
  color: #7fe3b4;
}

.bill-card__item-value.is-expense {
  color: #f6cd8e;
}

/* ---------- 月度明细卡 ---------- */
/* 卡片本身是抽屉入口：右侧给文字链接 + 箭头做可点提示，点按只加深投影，不整块变色 */
.month {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx 24rpx;
  background: #fff;
  border: 1rpx solid #e8efea;
  border-radius: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(6, 89, 63, 0.03);
  transition: box-shadow 0.16s ease;
}

.month--hover {
  box-shadow: 0 8rpx 20rpx rgba(6, 89, 63, 0.08);
}

.month__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #17211c;
}

.month__more {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
}

.month__more-text {
  margin-right: 6rpx;
  font-size: 23rpx;
  color: #8f939a;
}

.month__row {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
}

.mstat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 8rpx;
  text-align: center;
}

.mstat + .mstat {
  border-left: 1rpx solid #f0f4f1;
}

.mstat__label {
  font-size: 23rpx;
  color: #7f8782;
}

.mstat__value {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #17211c;
  font-weight: 600;
  word-break: break-all;
}

.mstat__value.is-income {
  color: #0a7d59;
}

.mstat__value.is-expense {
  color: #c98214;
}

.mstat__value.is-negative {
  color: #9a5410;
}

/* ---------- 信息流加载更多页脚 ---------- */
.stream-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 6rpx;
}

.stream-foot__text {
  font-size: 23rpx;
  color: #6d7a73;
}

/* ---------- 空态 / 骨架 / 说明 ---------- */
.empty-card {
  margin: 18rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.empty-card__hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9db2a7;
  line-height: 1.6;
  text-align: center;
}

.empty-card__retry {
  margin-top: 22rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  border: 1rpx solid #b9dccb;
  font-size: 26rpx;
  color: #0a7d59;
}

.empty-card__retry--hover {
  background: #eef7f2;
}

.skeleton {
  margin: 20rpx 24rpx 0;
}

.skeleton__row {
  height: 96rpx;
  margin-top: 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.05) 25%, rgba(255, 255, 255, 0.1) 37%, rgba(255, 255, 255, 0.05) 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.notice {
  display: flex;
  align-items: flex-start;
  margin: 28rpx 28rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
}

.notice__text {
  flex: 1;
  margin-left: 10rpx;
  font-size: 23rpx;
  color: #93a89c;
  line-height: 1.6;
}

/* ---------- 月度明细抽屉 ----------
   结构：抓手 → 月份标题（左右切月）+ 该月合计 → 明细滚动区 → 口径说明。
   抽屉占屏 78vh，头部与合计固定，只有明细区滚动，来回切月时版面不跳动 */
.sheet {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

/* 抓手：同时是下拉关闭手柄。整块是 44rpx 高的透明命中区，横条用伪元素画，
   这样手指压在横条边缘也能触发拖动（不依赖子节点） */
.sheet__handle {
  flex-shrink: 0;
  width: 240rpx;
  height: 44rpx;
  margin: 8rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet__handle::after {
  content: '';
  width: 72rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d2e0d9;
}

.sheet__handle--hover::after {
  background: #b8cec3;
}

.sheet__head {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 96rpx 18rpx;
}

/* 左右切月：到达当前年份首末月后置灰且不再响应点按 */
.sheet__arrow {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e7f2ec;
}

.sheet__arrow.is-disabled {
  background: transparent;
}

.sheet__title-box {
  min-width: 0;
  margin: 0 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #17211c;
  letter-spacing: 0.5rpx;
}

.sheet__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7f8782;
}

.sheet__close {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet__close--hover {
  background: #e7f2ec;
}

/* 该月合计沿用月度页的三栏结构，口径与卡片上的数值保持一致 */
.sheet__summary {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  margin: 0 24rpx;
  padding: 22rpx 8rpx;
  background: #fff;
  border: 1rpx solid #e8efea;
  border-radius: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(6, 89, 63, 0.03);
}

.sheet__scroll {
  flex: 1;
  min-height: 0;
  padding-top: 18rpx;
  box-sizing: border-box;
}

.sheet__empty {
  padding: 46rpx 24rpx 6rpx;
}

.sheet__notice {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 24rpx 30rpx;
}

.sheet__notice-text {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #6d8d7c;
}

.sheet__loading {
  flex: 1;
  min-height: 0;
  padding: 18rpx 24rpx 0;
}

.sheet__error {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 60rpx;
}

.sheet__error-text {
  font-size: 26rpx;
  color: #7f8782;
}

.sheet__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  border: 1rpx solid #b9dccb;
  font-size: 26rpx;
  color: #0a7d59;
}

.sheet__retry--hover {
  background: #e7f2ec;
}


/* ---------- 选择月份 / 选择年份弹窗 ---------- */
/* 只列已公开账期：chip 主文案是账期，副文案是公开状态 */
.periods {
  padding: 4rpx 28rpx 34rpx;
}

/* 年份数量少（通常 2~5 个），内容撑不起高度，面板会缩成一条矮条。
   这里给年份面板一个固定下限并把年份按钮居中，面板观感与月份面板一致 */
.periods--year {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 520rpx;
}

.periods__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 0 66rpx;
  font-size: 26rpx;
  color: #7f8782;
}

.periods__state-text {
  font-size: 26rpx;
  color: #7f8782;
}

.periods__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  border: 1rpx solid #b9dccb;
  font-size: 26rpx;
  color: #0a7d59;
}

.periods__retry--hover {
  background: #eef7f2;
}

.ps-years {
  display: flex;
  flex-wrap: wrap;
}

/* 年份 chip 一行两个，做成整行高的大按钮：年份字大、状态字在下。
   双类名是为了盖过后面的 .ps-chip 基础样式，不受声明顺序影响 */
.ps-chip.ps-chip--year {
  box-sizing: border-box;
  width: calc(50% - 14rpx);
  align-items: center;
  padding: 40rpx 0 34rpx;
  border-radius: 20rpx;
}

.ps-chip--year .ps-chip__label {
  font-size: 36rpx;
  font-weight: 600;
}

.ps-chip--year .ps-chip__tag {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.ps-group + .ps-group {
  margin-top: 28rpx;
}

.ps-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.ps-group__year {
  font-size: 27rpx;
  font-weight: 600;
  color: #17211c;
}

.ps-grid {
  display: flex;
  flex-wrap: wrap;
}

.ps-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 26rpx 12rpx;
  border: 1rpx solid #e6efe9;
  border-radius: 16rpx;
  background: #f8fbf9;
}

.ps-chip--hover {
  background: #eef7f2;
}

/* 当前账期用主色描边 + 主色文字标出，不只用底色区分 */
.ps-chip.is-active {
  border-color: #0a7d59;
  background: #e9f7ef;
}

.ps-chip.is-active .ps-chip__label {
  color: #0a7d59;
  font-weight: 600;
}

.ps-chip__label {
  font-size: 26rpx;
  color: #17211c;
  line-height: 1.4;
}

.ps-chip__tag {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: #17a273;
  line-height: 1.4;
}
