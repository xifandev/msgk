/* 财务公开：账单式设计 · 阳光绿主题（公开 / 明亮 / 通透）
   色彩：主色 #0a7d59，嫩绿 #35c885，浅绿底 #f4faf6；支出用暖沙色 #c98214 区分 */

.pane {
  background: #f4faf6;
  padding-bottom: 30rpx;
  min-height: 60vh;
}

/* 内容区、滚动区与标签页主体统一浅绿底，去掉说明文字下方的白色底块；
   不改 page-main 的 env(safe-area-inset-bottom) 外边距，继续保留 iPhone 底部安全区 */
.cellgroup,
.cellgroup__scroll,
.ms-tabs {
  background-color: #f4faf6;
}

.bottom-gap {
  height: 24rpx;
}

/* ---------- 时间选择条 ---------- */
/* 不再做成独立卡片：去掉白底、描边和阴影，直接落在浅绿内容区上，
   靠字号、留白和右侧文字链接区分层级，避免顶部堆三条横线 */
.period {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 左右内缩与下方结余卡的内文对齐（卡片外边距 24 + 内边距 28），保持视觉轴线一致 */
  margin: 16rpx 24rpx 0;
  padding: 10rpx 26rpx 6rpx;
  min-height: 80rpx;
  background: transparent;
  border: 0;
  box-shadow: none;
  box-sizing: border-box;
}

/* 无卡片时用文字变主色反馈，避免点按时整行闪白 */
.period--hover .period__text,
.period--hover .period__right {
  color: #0a7d59;
}

.period__left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.period__text {
  margin-left: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #17211c;
  letter-spacing: 0.5rpx;
}

.period__right {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #8f939a;
}

.period__right text {
  margin-right: 6rpx;
}

/* 吸顶标签栏与浅绿内容区之间靠色差分界，去掉组件自带的分隔线（addGlobalClass 已开启）；
   只留一层极淡的投影，内容滚到栏下方时才有层次，静止时几乎看不见 */
.ms-tabs.is-sticky .ms-tabs__nav {
  border-bottom: 0;
  box-shadow: 0 3rpx 10rpx rgba(6, 89, 63, 0.04);
}

/* ---------- 结余主卡 ---------- */
.balance {
  margin: 22rpx 24rpx 0;
  padding: 32rpx 28rpx 26rpx;
  border-radius: 28rpx;
  /* 去掉描边后靠渐变自身的深浅拉开与浅绿底色的差别（浅端不能太接近 #f4faf6），再加投影分层 */
  background: linear-gradient(148deg, #d9fae8 0%, #c2f2d7 50%, #a2e7c2 100%);
  box-shadow: 0 14rpx 32rpx rgba(32, 143, 91, 0.13);
}

.balance__label {
  font-size: 26rpx;
  color: #386b52;
  letter-spacing: 1rpx;
}

.balance__value {
  margin-top: 14rpx;
  font-size: 68rpx;
  font-weight: 700;
  color: #0c5a38;
  line-height: 1.2;
  letter-spacing: 1rpx;
  word-break: break-all;
}

/* 结余为负（支大于收）时换暖色，并保留负号，不只靠颜色区分 */
.balance__value.is-negative {
  color: #9a5410;
}

.balance__flow {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.52);
}

/* 两栏之间靠间距分隔，不画竖线 */
.flow {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.flow__label {
  font-size: 23rpx;
  color: #386b52;
}

.flow__value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0;
  word-break: break-all;
}

.flow__value.is-income {
  color: #0a7d59;
}

.flow__value.is-expense {
  color: #c98214;
}

/* ---------- 区块标题 ---------- */
.section {
  margin-top: 36rpx;
}

.section__head {
  display: flex;
  align-items: center;
  padding: 0 24rpx 14rpx;
}

.section__bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #35c885, #0a7d59);
  margin-right: 12rpx;
}

.section__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #17211c;
}

.section__extra {
  font-size: 24rpx;
  color: #7f8782;
}

/* ---------- 日期分组 ---------- */
.day {
  margin: 0 24rpx 20rpx;
}

.day__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.day__date {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #4c545e;
  font-weight: 500;
}

.day__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #17a273;
  margin-right: 10rpx;
}

.day__card {
  background: #fff;
  border-radius: 20rpx;
  padding: 4rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
  overflow: hidden;
}

.bill {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}

.bill:last-child {
  border-bottom: none;
}

.bill__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bill__icon.is-income {
  background: linear-gradient(135deg, #1aab7c 0%, #0a7d59 100%);
}

.bill__icon.is-expense {
  background: linear-gradient(135deg, #f2b455 0%, #dd9a2b 100%);
}

/* 收/支用正负号区分，不只靠颜色 */
.bill__glyph {
  font-size: 40rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1;
  transform: translateY(-2rpx);
}

.bill__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 18rpx;
}

.bill__summary {
  font-size: 30rpx;
  color: #17211c;
  line-height: 1.5;
  word-break: break-all;
}

.bill__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7f8782;
}

.bill__amount {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.bill__amount.is-income {
  color: #0a7d59;
}

.bill__amount.is-expense {
  color: #17211c;
}

/* ---------- 年度账单卡 ---------- */
/* 深绿实地卡片，只承载三个数值结论：年结余为主视觉，总收入 / 总支出在下沿分行对置。
   不再放柱状图与图例，靠字号、留白和明暗对比撑住版面。 */
.year {
  position: relative;
  overflow: hidden;
  margin: 18rpx 24rpx 0;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(158deg, #1e8a60 0%, #0f6a45 55%, #0b4d33 100%);
  box-shadow: 0 18rpx 40rpx rgba(10, 84, 56, 0.18);
}

/* 右上角柔光：纯装饰，不承载信息 */
.year__glow {
  position: absolute;
  top: -170rpx;
  right: -130rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 226, 168, 0.32) 0%, rgba(94, 226, 168, 0) 68%);
  pointer-events: none;
}

.year__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.year__title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* 公开月份数收进描边小标签，避免在标题下再压一行说明文字 */
.year__tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
}

.year__hero {
  position: relative;
  margin-top: 48rpx;
}

.year__hero-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 2rpx;
}

.year__hero-value {
  display: block;
  margin-top: 16rpx;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: 1rpx;
  color: #edfff6;
  word-break: break-all;
}

/* 年结余为负时换成暖沙色，不只靠符号区分 */
.year__hero-value.is-negative {
  color: #f7c98d;
}

.year__flow {
  position: relative;
  display: flex;
  align-items: flex-end;
  margin-top: 42rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.year__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.year__item--right {
  align-items: flex-end;
  text-align: right;
}

.year__item-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 1rpx;
}

.year__item-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.year__item-value.is-income {
  color: #7fe3b4;
}

.year__item-value.is-expense {
  color: #f6cd8e;
}

/* ---------- 月度明细卡 ---------- */
.month {
  margin: 0 24rpx 18rpx;
  padding: 22rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
}

.month__head {
  display: flex;
  align-items: center;
}

.month__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #17211c;
}

.month__row {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
}

.mstat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 8rpx;
  text-align: center;
}

.mstat + .mstat {
  border-left: 1rpx solid #edf3ef;
}

.mstat__label {
  font-size: 23rpx;
  color: #7f8782;
}

.mstat__value {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #17211c;
  font-weight: 600;
  word-break: break-all;
}

.mstat__value.is-income {
  color: #0a7d59;
}

.mstat__value.is-expense {
  color: #c98214;
}

.mstat__value.is-negative {
  color: #9a5410;
}

/* ---------- 空态 / 骨架 / 说明 ---------- */
.empty-card {
  margin: 18rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.empty-card__hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9db2a7;
  line-height: 1.6;
  text-align: center;
}

.skeleton {
  margin: 20rpx 24rpx 0;
}

.skeleton__hero {
  height: 300rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #eef3f0 25%, #e4ece7 37%, #eef3f0 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

.skeleton__row {
  height: 96rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f4f7f5 25%, #eaf0ec 37%, #f4f7f5 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.notice {
  display: flex;
  align-items: flex-start;
  margin: 28rpx 28rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #edf7f1;
}

.notice__text {
  flex: 1;
  margin-left: 10rpx;
  font-size: 23rpx;
  color: #4d7f68;
  line-height: 1.6;
}
