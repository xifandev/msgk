/* ---------- 标签页内容区：旧版灰底 ---------- */
.tab-box {
  background-color: #f8f7f7;
}

/* ---------- 年/月选择行 ---------- */
.select-time {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  padding-top: 50rpx;
  padding-bottom: 20rpx;
  font-size: 33rpx;
  color: #333;
  background-color: #fff;
  border-radius: 10rpx;
}

.select-time-icon {
  /* 旋转 */
  transform: rotate(90deg);
  margin-top: -2px;
  margin-left: 6rpx;
}

/* ---------- 统计块 ---------- */
.tongji-title {
  font-size: 30rpx;
  color: #333;
}

.tongji-money {
  font-size: 30rpx;
  color: #7b7b7b;
}

/* ---------- 月度明细 ---------- */
.shouru-zhaiyao {
  font-size: 30rpx;
}

.shouru-time {
  font-size: 26rpx;
  color: #999;
}

.shouru-box {
  margin-left: 3px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 收支类型标签 */
.type-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  /* ms-cell 图标列自带 24rpx 右间距，这里不再重复留白，保持旧版 24rpx 间距 */
  margin-right: 0;
  flex-shrink: 0;
}

.type-shouru {
  background: linear-gradient(135deg, #07C060 0%, #00B894 100%);
}

.type-zhichu {
  background: linear-gradient(135deg, #EFC104 0%, #F39C12 100%);
}

.type-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.shouru-money {
  font-size: 30rpx;
  font-weight: 500;
}

.money-shouru {
  color: #00BA88;
}

.money-zhichu {
  color: #EFBA09;
}

/* ---------- 年度月度明细 ---------- */
.tab-box-yuedu {
  margin-bottom: 10px;
}

.yuedu-title {
  font-size: 35rpx;
  color: #333;
}

/* ---------- 空态 ---------- */
.yuewushuju {
  background-color: #fff;
}

/* 旧版单元格上下内边距效果：上 10px、下 0 */
.ms-cell {
  padding-top: 20rpx !important;
  padding-bottom: 0 !important;
}
