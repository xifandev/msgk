/* 财务公开：低饱和浅色底、紧凑页头与按月整合的账单 */

.pane {
  min-height: 60vh;
  padding: 4rpx 0 32rpx;
  background: #f5f7f6;
}

.cellgroup,
.cellgroup__scroll,
.ms-tabs {
  background-color: #f5f7f6;
}

.ms-tabs__nav {
  width: calc(100% - 48rpx);
  height: 76rpx;
  margin: 20rpx 24rpx 0;
  padding: 6rpx;
  border: 0;
  border-radius: 18rpx;
  background: #e9eeeb;
}

.ms-tabs__item {
  border-radius: 13rpx;
  color: #76817b;
  font-size: 26rpx;
}

.ms-tabs__item.is-active {
  color: #145d45 !important;
  font-weight: 600;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(27, 54, 43, 0.08);
}

.ms-tabs__line {
  display: none;
}

.ms-tabs.is-sticky .ms-tabs__nav {
  border-bottom: 0;
  box-shadow: 0 5rpx 16rpx rgba(27, 54, 43, 0.06);
}

.bottom-gap {
  height: 24rpx;
}

/* 区块标题 */
.section {
  margin-top: 32rpx;
}

.section__head {
  display: flex;
  align-items: center;
  padding: 0 28rpx 16rpx;
}

.section__bar {
  display: none;
}

.section__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2721;
}

.section__extra {
  font-size: 22rpx;
  color: #8a948f;
}

/* 每月一张完整账单：汇总与每日明细保持在同一阅读上下文 */
.month-group {
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  border: 1rpx solid #e6ece8;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 22rpx rgba(30, 57, 45, 0.035);
}

.month-group__head {
  padding: 28rpx 28rpx 24rpx;
}

.month-group__title-box {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-width: 0;
}

.month-group__title {
  flex-shrink: 0;
  color: #17251f;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.3;
  white-space: nowrap;
}

.month-group__meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #8a948f;
  font-size: 22rpx;
  white-space: nowrap;
}

.month-group__sum {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #f6f8f7;
}

.month-group__sum-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
}

.month-group__sum-item + .month-group__sum-item {
  border-left: 1rpx solid #e4eae6;
}

.month-group__sum-label {
  margin-bottom: 8rpx;
  color: #7d8882;
  font-size: 22rpx;
  line-height: 1.3;
}

.month-group__sum-label.is-income {
  color: #397860;
}

.month-group__sum-label.is-expense {
  color: #8a7356;
}

.month-group__sum-value {
  color: #24322c;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.month-group__empty {
  margin: 0 28rpx 28rpx;
  padding: 36rpx 20rpx;
  border-radius: 16rpx;
  background: #f6f8f7;
  text-align: center;
}

.month-group__empty-text {
  color: #8a948f;
  font-size: 24rpx;
}

/* 日期是账单内的小节，不再拆成一张张独立卡片 */
.day {
  padding: 0 28rpx;
}

.day:last-child {
  padding-bottom: 12rpx;
}

.day__head {
  display: flex;
  align-items: center;
  padding: 20rpx 0 8rpx;
}

.day__date {
  flex-shrink: 0;
  color: #78847e;
  font-size: 23rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.day__rule {
  flex: 1;
  height: 1rpx;
  margin-left: 14rpx;
  background: #edf0ee;
}

.day__card {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.bill {
  position: relative;
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 24rpx 0;
}

.bill::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  left: 60rpx;
  height: 1rpx;
  background: #f0f2f1;
}

.bill:last-child::after {
  display: none;
}

.bill__mark {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 13rpx;
}

.bill__mark.is-income {
  background: #edf6f1;
}

.bill__mark.is-expense {
  background: #f7f3ed;
}

.bill__glyph {
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

.bill__mark.is-income .bill__glyph {
  color: #197454;
}

.bill__mark.is-expense .bill__glyph {
  color: #9a7748;
}

.bill__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 16rpx;
}

.bill__summary {
  color: #202b26;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
  word-break: break-all;
}

.bill__sub {
  margin-top: 4rpx;
  color: #98a09b;
  font-size: 20rpx;
  line-height: 1.35;
}

.bill__amount {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  margin-left: 12rpx;
  font-variant-numeric: tabular-nums;
}

.bill__currency {
  margin-right: 3rpx;
  color: #9aa29e;
  font-size: 21rpx;
  font-weight: 400;
}

.bill__value {
  color: #26332d;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
}

.bill__amount.is-income .bill__value {
  color: #197454;
}

.bill__amount.is-expense .bill__value {
  color: #26332d;
}

/* 年度汇总：白色卡片与明细页保持同一视觉语言 */
.bill-card {
  position: relative;
  margin: 24rpx 24rpx 0;
  padding: 30rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid #e6ece8;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 22rpx rgba(30, 57, 45, 0.035);
}

.bill-card__glow {
  display: none;
}

.bill-card__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}

.bill-card__title {
  flex: 1;
  min-width: 0;
  color: #17251f;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.bill-card__switch {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  margin-left: 16rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #eef5f1;
}

.bill-card__switch--hover {
  background: #e3eee8;
}

.bill-card__switch-text {
  margin-right: 6rpx;
  color: #176b4e;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1;
}

.bill-card__hero {
  position: relative;
  margin-top: 36rpx;
}

.bill-card__hero-label {
  display: block;
  color: #8a948f;
  font-size: 23rpx;
}

.bill-card__hero-value {
  display: block;
  margin-top: 12rpx;
  color: #14281f;
  font-size: 64rpx;
  font-weight: 650;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.bill-card__hero-value.is-negative {
  color: #9b5d31;
}

.bill-card__flow {
  position: relative;
  display: flex;
  align-items: flex-end;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf0ee;
}

.bill-card__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bill-card__item--right {
  align-items: flex-end;
  text-align: right;
}

.bill-card__item-label {
  color: #8a948f;
  font-size: 22rpx;
}

.bill-card__item-value {
  margin-top: 10rpx;
  color: #26332d;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.bill-card__item-value.is-income {
  color: #197454;
}

.bill-card__item-value.is-expense {
  color: #6f6252;
}

.bill-card__empty {
  position: relative;
  margin-top: 32rpx;
  padding-bottom: 4rpx;
}

.bill-card__empty-text {
  color: #8a948f;
  font-size: 25rpx;
  line-height: 1.6;
}

/* 年度页的月份入口 */
.month {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #e6ece8;
  border-radius: 20rpx;
  background: #ffffff;
  transition: background-color 0.16s ease;
}

.month--hover {
  background: #fafcfb;
}

.month__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month__name {
  flex: 1;
  min-width: 0;
  color: #1b2923;
  font-size: 29rpx;
  font-weight: 600;
}

.month__more {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
}

.month__more-text {
  margin-right: 6rpx;
  color: #8a948f;
  font-size: 22rpx;
}

.month__row {
  display: flex;
  align-items: stretch;
  margin-top: 22rpx;
}

.mstat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 12rpx;
  text-align: left;
}

.month__row .mstat:first-child {
  padding-left: 0;
}

.mstat + .mstat {
  border-left: 1rpx solid #edf0ee;
}

.mstat__label {
  color: #8a948f;
  font-size: 21rpx;
  white-space: nowrap;
}

.mstat__value {
  margin-top: 8rpx;
  color: #26332d;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.mstat__value.is-income {
  color: #197454;
}

.mstat__value.is-expense {
  color: #6f6252;
}

.mstat__value.is-negative {
  color: #9b5d31;
}

/* 加载、空态与公开说明 */
.stream-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0 6rpx;
}

.stream-foot__text {
  color: #8a948f;
  font-size: 22rpx;
}

.empty-card {
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  border: 1rpx solid #e6ece8;
  border-radius: 24rpx;
  background: #ffffff;
}

.empty-card__hint {
  margin-top: 10rpx;
  color: #8a948f;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-card__retry {
  margin-top: 22rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #cbded4;
  border-radius: 14rpx;
  color: #176b4e;
  font-size: 25rpx;
}

.empty-card__retry--hover {
  background: #eef5f1;
}

.skeleton {
  margin: 24rpx 24rpx 0;
}

.skeleton__row {
  height: 96rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #e9eeeb 25%, #f3f6f4 37%, #e9eeeb 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.notice {
  display: flex;
  align-items: flex-start;
  margin: 26rpx 28rpx 0;
  padding: 12rpx 4rpx;
}

.notice__text {
  flex: 1;
  margin-left: 10rpx;
  color: #8a948f;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 月度明细抽屉 */
.sheet {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
  background: #f5f7f6;
}

.sheet__handle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 44rpx;
  margin: 8rpx auto 0;
}

.sheet__handle::after {
  content: '';
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d4dcd7;
}

.sheet__handle--hover::after {
  background: #b8c6be;
}

.sheet__head {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 96rpx 20rpx;
}

.sheet__arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #e9f0ec;
}

.sheet__arrow.is-disabled {
  background: transparent;
}

.sheet__title-box {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 12rpx;
}

.sheet__title {
  color: #17251f;
  font-size: 32rpx;
  font-weight: 600;
}

.sheet__sub {
  margin-top: 6rpx;
  color: #8a948f;
  font-size: 22rpx;
}

.sheet__close {
  position: absolute;
  top: 50%;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  transform: translateY(-50%);
}

.sheet__close--hover {
  background: #e9f0ec;
}

.sheet__summary {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  margin: 0 24rpx;
  padding: 22rpx 8rpx;
  border: 1rpx solid #e6ece8;
  border-radius: 20rpx;
  background: #ffffff;
}

.sheet__summary .mstat {
  align-items: center;
  text-align: center;
}

.sheet__scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  margin: 20rpx 24rpx 0;
  padding: 4rpx 24rpx 0;
  border: 1rpx solid #e6ece8;
  border-radius: 20rpx;
  background: #ffffff;
}

.sheet__scroll .day {
  padding: 0;
}

.sheet__empty {
  padding: 46rpx 0 6rpx;
}

.sheet__notice {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 24rpx 30rpx;
}

.sheet__notice-text {
  margin-left: 8rpx;
  color: #8a948f;
  font-size: 21rpx;
}

.sheet__loading {
  flex: 1;
  min-height: 0;
  padding: 18rpx 24rpx 0;
}

.sheet__error {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 60rpx;
}

.sheet__error-text {
  color: #8a948f;
  font-size: 25rpx;
}

.sheet__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #cbded4;
  border-radius: 14rpx;
  color: #176b4e;
  font-size: 25rpx;
}

.sheet__retry--hover {
  background: #e9f0ec;
}

/* 年份选择 */
.periods {
  padding: 4rpx 28rpx 34rpx;
}

.periods--year {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 480rpx;
}

.periods__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 0 66rpx;
  color: #8a948f;
  font-size: 25rpx;
}

.periods__state-text {
  color: #8a948f;
  font-size: 25rpx;
}

.periods__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #cbded4;
  border-radius: 14rpx;
  color: #176b4e;
  font-size: 25rpx;
}

.periods__retry--hover {
  background: #eef5f1;
}

.ps-years {
  display: flex;
  flex-wrap: wrap;
}

.ps-chip.ps-chip--year {
  box-sizing: border-box;
  align-items: center;
  width: calc(50% - 14rpx);
  padding: 34rpx 0 30rpx;
  border-radius: 18rpx;
}

.ps-chip--year .ps-chip__label {
  font-size: 34rpx;
  font-weight: 600;
}

.ps-chip--year .ps-chip__tag {
  margin-top: 8rpx;
  font-size: 21rpx;
}

.ps-group + .ps-group {
  margin-top: 28rpx;
}

.ps-group__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}

.ps-group__year {
  color: #17251f;
  font-size: 27rpx;
  font-weight: 600;
}

.ps-grid {
  display: flex;
  flex-wrap: wrap;
}

.ps-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 26rpx 12rpx;
  border: 1rpx solid #e2eae5;
  border-radius: 14rpx;
  background: #f7f9f8;
}

.ps-chip--hover {
  background: #eef5f1;
}

.ps-chip.is-active {
  border-color: #197454;
  background: #edf6f1;
}

.ps-chip.is-active .ps-chip__label {
  color: #176b4e;
  font-weight: 600;
}

.ps-chip__label {
  color: #17251f;
  font-size: 26rpx;
  line-height: 1.4;
}

.ps-chip__tag {
  margin-top: 2rpx;
  color: #197454;
  font-size: 21rpx;
  line-height: 1.4;
}
