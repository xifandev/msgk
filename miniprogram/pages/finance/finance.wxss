/* 财务公开：账单式设计 */

.pane {
  background: linear-gradient(180deg, #f6f7f9 0%, #f6f7f9 100%);
  padding-bottom: 30rpx;
  min-height: 60vh;
}

/* ---------- 时间选择条 ---------- */
.period {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 0 24rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.period--hover {
  background: #fafbfc;
}

.period__left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.period__text {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  letter-spacing: 0.5rpx;
}

.period__right {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8f939a;
}

.period__right text {
  margin-right: 6rpx;
}

/* ---------- 结余主卡 ---------- */
.balance {
  position: relative;
  margin: 20rpx 24rpx 0;
  padding: 30rpx 28rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #c00d22 0%, #d31027 42%, #ef4a5a 100%);
  box-shadow: 0 14rpx 34rpx rgba(211, 16, 39, 0.26);
  overflow: hidden;
}

.balance__glow {
  position: absolute;
  right: -100rpx;
  top: -140rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.balance__top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.balance__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 1rpx;
}

.balance__delta {
  display: flex;
  align-items: center;
  max-width: 62%;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 21rpx;
  color: #fff;
}

.balance__delta text {
  margin-left: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.balance__delta .balance__delta-arrow {
  margin-left: 0;
  margin-right: 4rpx;
  overflow: visible;
  font-size: 24rpx;
  line-height: 1;
}

/* 环比方向除颜色外还有箭头图标与文字，不单靠颜色区分 */
.balance__delta.is-up {
  background: rgba(255, 255, 255, 0.24);
}

.balance__delta.is-down {
  background: rgba(0, 0, 0, 0.16);
}

.balance__delta.is-flat {
  background: rgba(255, 255, 255, 0.16);
}

.balance__value {
  position: relative;
  margin-top: 14rpx;
  font-size: 68rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  letter-spacing: 1rpx;
  word-break: break-all;
}

.balance__flow {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding: 18rpx 4rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.14);
}

.flow {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flow__label {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
}

.flow__value {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0;
  word-break: break-all;
}

.flow__split {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.24);
}

/* 收支占比条 */
.ratio {
  position: relative;
  margin-top: 22rpx;
}

.ratio__bar {
  display: flex;
  width: 100%;
  height: 10rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
}

.ratio__income {
  height: 100%;
  background: #6ee7b7;
  transition: width 0.3s ease;
}

.ratio__expense {
  height: 100%;
  background: #ffd08a;
  transition: width 0.3s ease;
}

.ratio__legend {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.ratio__legend-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.82);
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot--income {
  background: #00b578;
}

.dot--expense {
  background: #f0a020;
}

.ratio__legend .dot--income {
  background: #6ee7b7;
}

.ratio__legend .dot--expense {
  background: #ffd08a;
}

/* ---------- 区块标题 ---------- */
.section {
  margin-top: 30rpx;
}

.section__head {
  display: flex;
  align-items: center;
  padding: 0 32rpx 14rpx;
}

.section__bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #ef4a5a, #d31027);
  margin-right: 12rpx;
}

.section__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.section__extra {
  font-size: 22rpx;
  color: #9a9ca1;
}

/* ---------- 日期分组 ---------- */
.day {
  margin: 0 24rpx 20rpx;
}

.day__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.day__date {
  font-size: 24rpx;
  color: #646566;
  font-weight: 500;
}

.day__sum {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9a9ca1;
}

.day__sum text {
  margin-left: 16rpx;
}

.day__card {
  background: #fff;
  border-radius: 20rpx;
  padding: 4rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
  overflow: hidden;
}

.bill {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f4f5f7;
}

.bill:last-child {
  border-bottom: none;
}

.bill__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bill__icon.is-income {
  background: linear-gradient(135deg, #12b981 0%, #0aa06e 100%);
}

.bill__icon.is-expense {
  background: linear-gradient(135deg, #f7b955 0%, #eda020 100%);
}

/* 收/支用正负号区分，不只靠颜色 */
.bill__glyph {
  font-size: 40rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1;
  transform: translateY(-2rpx);
}

.bill__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 18rpx;
}

.bill__summary {
  font-size: 30rpx;
  color: #1f2329;
  line-height: 1.5;
  word-break: break-all;
}

.bill__sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a9ca1;
}

.bill__amount {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.bill__amount.is-income {
  color: #00a06e;
}

.bill__amount.is-expense {
  color: #1f2329;
}

/* ---------- 年度账单卡 ---------- */
.year {
  margin: 20rpx 24rpx 0;
  padding: 26rpx 24rpx 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(160deg, #ffffff 0%, #fff5f6 100%);
  box-shadow: 0 10rpx 30rpx rgba(211, 16, 39, 0.08);
}

.year__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.year__title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.year__sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a9ca1;
}

.year__badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ef4a5a, #d31027);
  display: flex;
  align-items: center;
  justify-content: center;
}

.year__totals {
  display: flex;
  align-items: stretch;
  margin-top: 22rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f7e3e5;
  border-bottom: 1rpx solid #f7e3e5;
}

.total {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.total__label {
  font-size: 22rpx;
  color: #9a9ca1;
}

.total__value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
  word-break: break-all;
}

.total__value.is-income {
  color: #00a06e;
}

.total__value.is-expense {
  color: #e88411;
}

/* 柱状对比图 */
.chart {
  position: relative;
  margin-top: 26rpx;
  height: 240rpx;
  padding-top: 10rpx;
}

.chart__grid {
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  bottom: 34rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chart__line {
  height: 1rpx;
  background: #f3e6e8;
}

.chart__cols {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 100%;
  padding-bottom: 34rpx;
  box-sizing: border-box;
}

.chart__col {
  position: relative;
  flex: 1;
  min-width: 0;
  max-width: 96rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.chart__bars {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart__bar {
  width: 20rpx;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  transition: height 0.3s ease;
}

.chart__bar--income {
  background: linear-gradient(180deg, #34d399 0%, #00a06e 100%);
  margin-right: 6rpx;
}

.chart__bar--expense {
  background: linear-gradient(180deg, #fcc66d 0%, #eda020 100%);
}

.chart__label {
  position: absolute;
  bottom: -30rpx;
  font-size: 20rpx;
  color: #9a9ca1;
  line-height: 1.4;
}

.chart__legend {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}

.legend {
  display: flex;
  align-items: center;
  margin: 0 14rpx;
  font-size: 21rpx;
  color: #7b7f86;
}

/* ---------- 月度明细卡 ---------- */
.month {
  margin: 0 24rpx 18rpx;
  padding: 22rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.month__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.month__balance {
  display: flex;
  align-items: baseline;
  font-size: 22rpx;
  color: #9a9ca1;
}

.month__balance-value {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #d31027;
}

.month__row {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
}

.mstat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mstat__label {
  font-size: 22rpx;
  color: #9a9ca1;
}

.mstat__value {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
  word-break: break-all;
}

.mstat__value.is-income {
  color: #00a06e;
}

.mstat__value.is-expense {
  color: #e88411;
}

.month__bar {
  display: flex;
  width: 100%;
  height: 8rpx;
  margin-top: 18rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: #f4f5f7;
}

.month__bar-income {
  height: 100%;
  background: linear-gradient(90deg, #34d399, #00a06e);
}

.month__bar-expense {
  height: 100%;
  background: linear-gradient(90deg, #fcc66d, #eda020);
}

/* ---------- 空态 / 骨架 ---------- */
.empty-wrap {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 0;
}

.skeleton {
  height: 360rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #f4f5f7 25%, #eceef1 37%, #f4f5f7 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
