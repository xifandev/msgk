/* 财务公开：账单式设计 · 阳光绿主题（公开 / 明亮 / 通透）
   色彩：主色 #0a7d59，嫩绿 #35c885，浅绿底 #f4faf6；支出用暖沙色 #c98214 区分 */

.pane {
  min-height: 60vh;
  padding: 4rpx 0 32rpx;
  background: #f4faf6;
}

/* 内容区、滚动区与标签页主体统一浅绿底；
   不改 page-main 的 env(safe-area-inset-bottom) 外边距，继续保留 iPhone 底部安全区 */
.cellgroup,
.cellgroup__scroll,
.ms-tabs {
  background-color: #f4faf6;
}

/* 吸顶标签栏恢复白底下划线样式：靠与浅绿内容区的色差分界，只留一层极淡的投影 */
.ms-tabs.is-sticky .ms-tabs__nav {
  border-bottom: 0;
  box-shadow: 0 3rpx 10rpx rgba(6, 89, 63, 0.04);
}

.bottom-gap {
  height: 24rpx;
}

/* ---------- 区块标题 ---------- */
.section {
  margin-top: 36rpx;
}

.section__head {
  display: flex;
  align-items: center;
  padding: 0 24rpx 14rpx;
}

.section__bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #35c885, #0a7d59);
  margin-right: 12rpx;
}

.section__title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #17211c;
}

.section__extra {
  font-size: 24rpx;
  color: #7f8782;
}

/* ---------- 月度信息流：每月一组 ---------- */
.month-group {
  margin-top: 36rpx;
}

.month-group:first-child {
  margin-top: 20rpx;
}

/* 每月收支不进独立卡片：直接落在内容区上做区块标题，
   渐变竖条 + 月份 + 笔数一行，收入/支出小字随行 */
.month-group__head {
  padding: 0 24rpx;
}

.month-group__title-box {
  display: flex;
  align-items: center;
  min-width: 0;
}

.month-group__bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #35c885, #0a7d59);
  margin-right: 12rpx;
}

.month-group__title {
  flex: 1;
  min-width: 0;
  color: #17211c;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
}

.month-group__meta {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #7f8782;
  font-size: 24rpx;
  white-space: nowrap;
}

.month-group__sum {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
  padding-left: 18rpx;
}

.month-group__sum-label {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #7f8782;
  font-size: 23rpx;
  line-height: 1.3;
}

.month-group__sum-value {
  margin-right: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.month-group__sum-value.is-income {
  color: #0a7d59;
}

.month-group__sum-value.is-expense {
  color: #c98214;
}

.month-group__empty {
  margin: 14rpx 24rpx 0;
  padding-left: 18rpx;
}

.month-group__empty-text {
  color: #9db2a7;
  font-size: 24rpx;
}

/* ---------- 日期分组 ---------- */
.day {
  margin: 24rpx 24rpx 0;
}

.day__head {
  display: flex;
  align-items: center;
  padding: 0 8rpx 12rpx;
}

.day__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #17a273;
  margin-right: 10rpx;
}

.day__date {
  font-size: 26rpx;
  color: #4c545e;
  font-weight: 500;
}

.day__card {
  padding: 4rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
  overflow: hidden;
}

.bill {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}

.bill:last-child {
  border-bottom: none;
}

/* 收/支图标：收入绿渐变、支出橙渐变的圆角方块，白色正负号 */
.bill__mark {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
}

.bill__mark.is-income {
  background: linear-gradient(135deg, #1aab7c 0%, #0a7d59 100%);
}

.bill__mark.is-expense {
  background: linear-gradient(135deg, #f2b455 0%, #dd9a2b 100%);
}

.bill__glyph {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1;
  color: #fff;
  transform: translateY(-2rpx);
}

.bill__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 0 18rpx;
}

.bill__summary {
  color: #17211c;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
}

.bill__sub {
  margin-top: 6rpx;
  color: #7f8782;
  font-size: 24rpx;
  line-height: 1.35;
}

/* 金额带正负号：收入绿色，支出深色（支大于收语义靠符号区分，不只靠颜色） */
.bill__amount {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  font-variant-numeric: tabular-nums;
}

.bill__amount.is-income {
  color: #0a7d59;
}

.bill__amount.is-expense {
  color: #17211c;
}

/* ---------- 年度账单卡 ---------- */
/* 深绿实地卡片：期末结余为主视觉，年总收入 / 年总支出在下沿分行对置；
   切换年份收进标题行右侧的白底实心胶囊 */
.bill-card {
  position: relative;
  overflow: hidden;
  margin: 22rpx 24rpx 0;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(158deg, #1e8a60 0%, #0f6a45 55%, #0b4d33 100%);
  box-shadow: 0 18rpx 40rpx rgba(10, 84, 56, 0.18);
}

/* 右上角柔光：纯装饰，不承载信息 */
.bill-card__glow {
  position: absolute;
  top: -170rpx;
  right: -130rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 226, 168, 0.32) 0%, rgba(94, 226, 168, 0) 68%);
  pointer-events: none;
}

.bill-card__head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
}

.bill-card__title {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.bill-card__switch {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  margin-left: 16rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(8, 61, 40, 0.18);
}

.bill-card__switch--hover {
  background: #eef7f2;
}

.bill-card__switch-text {
  margin-right: 6rpx;
  color: #0b5c3d;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
}

.bill-card__hero {
  position: relative;
  margin-top: 44rpx;
}

.bill-card__hero-label {
  display: block;
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.bill-card__hero-value {
  display: block;
  margin-top: 16rpx;
  color: #edfff6;
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

/* 年结余为负时换成暖沙色，不只靠符号区分 */
.bill-card__hero-value.is-negative {
  color: #f7c98d;
}

.bill-card__flow {
  position: relative;
  display: flex;
  align-items: flex-end;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.bill-card__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bill-card__item--right {
  align-items: flex-end;
  text-align: right;
}

.bill-card__item-label {
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.bill-card__item-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.bill-card__item-value.is-income {
  color: #7fe3b4;
}

.bill-card__item-value.is-expense {
  color: #f6cd8e;
}

.bill-card__empty {
  position: relative;
  margin-top: 36rpx;
  padding-bottom: 4rpx;
}

.bill-card__empty-text {
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  line-height: 1.6;
}

/* ---------- 年度页的月份入口卡 ---------- */
.month {
  margin: 0 24rpx 18rpx;
  padding: 22rpx 24rpx 20rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
  transition: background-color 0.16s ease;
}

.month--hover {
  background: #f2f9f5;
}

.month__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month__name {
  flex: 1;
  min-width: 0;
  color: #17211c;
  font-size: 30rpx;
  font-weight: 600;
}

.month__more {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
}

.month__more-text {
  margin-right: 6rpx;
  color: #8f939a;
  font-size: 22rpx;
}

.month__row {
  display: flex;
  align-items: stretch;
  margin-top: 18rpx;
}

.mstat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 8rpx;
  text-align: center;
}

.mstat + .mstat {
  border-left: 1rpx solid #edf3ef;
}

.mstat__label {
  color: #7f8782;
  font-size: 23rpx;
  white-space: nowrap;
}

.mstat__value {
  margin-top: 8rpx;
  color: #17211c;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.mstat__value.is-income {
  color: #0a7d59;
}

.mstat__value.is-expense {
  color: #c98214;
}

.mstat__value.is-negative {
  color: #9a5410;
}

/* ---------- 加载、空态与公开说明 ---------- */
.stream-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 0 6rpx;
}

.stream-foot__text {
  color: #7f8782;
  font-size: 22rpx;
}

.empty-card {
  margin: 24rpx 24rpx 0;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
}

.empty-card__hint {
  margin-top: 10rpx;
  color: #9db2a7;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.empty-card__retry {
  margin-top: 22rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #bfe0d0;
  border-radius: 14rpx;
  color: #0a7d59;
  font-size: 25rpx;
}

.empty-card__retry--hover {
  background: #eef7f2;
}

.skeleton {
  margin: 24rpx 24rpx 0;
}

.skeleton__row {
  height: 96rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #eef3f0 25%, #e4ece7 37%, #eef3f0 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

.skeleton__row:first-child {
  margin-top: 0;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.notice {
  display: flex;
  align-items: flex-start;
  margin: 28rpx 28rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #edf7f1;
}

.notice__text {
  flex: 1;
  margin-left: 10rpx;
  color: #4d7f68;
  font-size: 23rpx;
  line-height: 1.6;
}

/* ---------- 月度明细抽屉 ---------- */
.sheet {
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
  background: #f4faf6;
}

.sheet__handle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 44rpx;
  margin: 8rpx auto 0;
}

.sheet__handle::after {
  content: '';
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #cfddd5;
}

.sheet__handle--hover::after {
  background: #aec6ba;
}

.sheet__head {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 96rpx 20rpx;
}

.sheet__arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(6, 89, 63, 0.06);
}

.sheet__arrow.is-disabled {
  background: transparent;
  box-shadow: none;
}

.sheet__title-box {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 12rpx;
}

.sheet__title {
  color: #17211c;
  font-size: 32rpx;
  font-weight: 600;
}

.sheet__sub {
  margin-top: 6rpx;
  color: #7f8782;
  font-size: 22rpx;
}

.sheet__close {
  position: absolute;
  top: 50%;
  right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  transform: translateY(-50%);
}

.sheet__close--hover {
  background: #e6f2eb;
}

/* 抽屉内该月合计：白底三栏卡，与年度页月份卡同一口径 */
.sheet__summary {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  margin: 0 24rpx;
  padding: 22rpx 8rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(6, 89, 63, 0.05);
}

.sheet__scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  margin-top: 4rpx;
  padding: 0 0 24rpx;
}

.sheet__scroll .day {
  margin: 24rpx 24rpx 0;
}

.sheet__empty {
  margin: 24rpx 24rpx 0;
  padding: 46rpx 0;
  border-radius: 20rpx;
  background: #fff;
}

.sheet__notice {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 24rpx 30rpx;
}

.sheet__notice-text {
  margin-left: 8rpx;
  color: #4d7f68;
  font-size: 21rpx;
}

.sheet__loading {
  flex: 1;
  min-height: 0;
  padding: 18rpx 24rpx 0;
}

.sheet__error {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 60rpx;
}

.sheet__error-text {
  color: #7f8782;
  font-size: 25rpx;
}

.sheet__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #bfe0d0;
  border-radius: 14rpx;
  color: #0a7d59;
  font-size: 25rpx;
}

.sheet__retry--hover {
  background: #e6f2eb;
}

/* ---------- 年份选择 ---------- */
.periods {
  padding: 4rpx 28rpx 34rpx;
}

.periods--year {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 480rpx;
}

.periods__state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 0 66rpx;
  color: #7f8782;
  font-size: 25rpx;
}

.periods__state-text {
  color: #7f8782;
  font-size: 25rpx;
}

.periods__retry {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  border: 1rpx solid #bfe0d0;
  border-radius: 14rpx;
  color: #0a7d59;
  font-size: 25rpx;
}

.periods__retry--hover {
  background: #eef7f2;
}

.ps-years {
  display: flex;
  flex-wrap: wrap;
}

.ps-chip.ps-chip--year {
  box-sizing: border-box;
  align-items: center;
  width: calc(50% - 14rpx);
  padding: 34rpx 0 30rpx;
  border-radius: 18rpx;
}

.ps-chip--year .ps-chip__label {
  font-size: 34rpx;
  font-weight: 600;
}

.ps-chip--year .ps-chip__tag {
  margin-top: 8rpx;
  font-size: 21rpx;
}

.ps-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 26rpx 12rpx;
  border: 1rpx solid #e2eae5;
  border-radius: 14rpx;
  background: #f7f9f8;
}

.ps-chip--hover {
  background: #eef7f2;
}

.ps-chip.is-active {
  border-color: #0a7d59;
  background: #edf6f1;
}

.ps-chip.is-active .ps-chip__label {
  color: #0a7d59;
  font-weight: 600;
}

.ps-chip__label {
  color: #17211c;
  font-size: 28rpx;
  line-height: 1.4;
}

.ps-chip__tag {
  margin-top: 2rpx;
  color: #0a7d59;
  font-size: 21rpx;
  line-height: 1.4;
}
