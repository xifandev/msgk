<page-main theme="green" custom-nav title="财务公开" subtitle="{{ venueName }}" bind:chudi="onScrollLower">
  <ms-tabs tabs="{{ ['月度收支', '年度收支'] }}" active="{{ active }}" animated swipeable sticky color="#0a7d59" bind:change="onTabChange">
    <view class="pane">
      <!-- ================= 月度收支（信息流） ================= -->
      <block wx:if="{{ active === 0 }}">
        <!-- 公开总览卡：公开月数 + 最新期末结余 + 累计收入/支出，取代原单月统计卡 -->
        <view class="bill-card">
          <view class="bill-card__glow"></view>

          <view class="bill-card__head">
            <text class="bill-card__title">{{ monthOverview ? '收支总览' : '月度收支' }}</text>
            <text class="bill-card__meta" wx:if="{{ monthOverview }}">已公开 {{ monthOverview.publishedText }} 个月</text>
          </view>

          <block wx:if="{{ monthOverview }}">
            <view class="bill-card__hero">
              <text class="bill-card__hero-label">期末结余（元）</text>
              <text class="bill-card__hero-value {{ monthOverview.latestNegative ? 'is-negative' : '' }}">{{ monthOverview.latestText }}</text>
            </view>

            <view class="bill-card__flow">
              <view class="bill-card__item">
                <text class="bill-card__item-label">累计收入</text>
                <text class="bill-card__item-value is-income">{{ monthOverview.incomeText }}</text>
              </view>
              <view class="bill-card__item bill-card__item--right">
                <text class="bill-card__item-label">累计支出</text>
                <text class="bill-card__item-value is-expense">{{ monthOverview.expenseText }}</text>
              </view>
            </view>
          </block>

          <view class="bill-card__empty" wx:else>
            <text class="bill-card__empty-text">{{ monthStreamState === 'error' ? '账单加载失败' : (monthStreamState === 'ready' ? '该场所暂无公开账单' : '正在加载…') }}</text>
          </view>
        </view>

        <!-- 月份信息流：每个公开月份一张卡，点开查看该月明细；下滑自动加载更早月份 -->
        <view class="section" wx:if="{{ monthList.length > 0 }}">
          <view class="section__head">
            <view class="section__bar"></view>
            <text class="section__title">月度明细</text>
            <text class="section__extra">已公开 {{ monthOverview.publishedText }} 个月</text>
          </view>

          <view
            class="month"
            wx:for="{{ monthList }}"
            wx:key="month"
            data-index="{{ index }}"
            bind:tap="openStreamMonthDetail"
            hover-class="month--hover"
            aria-role="button"
            aria-label="查看 {{ item.monthText }} 收支明细"
          >
            <view class="month__head">
              <text class="month__name">{{ item.monthText }}</text>
              <view class="month__more">
                <text class="month__more-text">查看明细</text>
                <ms-icon name="arrow" size="20rpx" color="#8f939a" />
              </view>
            </view>

            <view class="month__row">
              <view class="mstat">
                <text class="mstat__label">本月收入</text>
                <text class="mstat__value is-income">{{ item.incomeText }}</text>
              </view>
              <view class="mstat">
                <text class="mstat__label">本月支出</text>
                <text class="mstat__value is-expense">{{ item.expenseText }}</text>
              </view>
              <view class="mstat">
                <text class="mstat__label">期末结余</text>
                <text class="mstat__value {{ item.currentNegative ? 'is-negative' : '' }}">{{ item.currentText }}</text>
              </view>
            </view>
          </view>

          <!-- 加载更多状态：加载中 / 已到底 -->
          <view class="stream-foot">
            <block wx:if="{{ streamLoadingMore }}">
              <text class="stream-foot__text">加载更多月份…</text>
            </block>
            <block wx:elif="{{ !monthHasMore }}">
              <text class="stream-foot__text">已展示全部公开月份</text>
            </block>
          </view>
        </view>

        <!-- 首屏骨架 -->
        <view class="skeleton" wx:elif="{{ monthStreamState === 'loading' }}">
          <view class="skeleton__row"></view>
          <view class="skeleton__row"></view>
          <view class="skeleton__row"></view>
        </view>

        <!-- 首屏加载失败 -->
        <view class="empty-card" wx:elif="{{ monthStreamState === 'error' }}">
          <ms-empty description="账单加载失败">
            <view class="empty-card__retry" bind:tap="retryMonthStream" hover-class="empty-card__retry--hover" aria-role="button" aria-label="重新加载">重新加载</view>
          </ms-empty>
        </view>
      </block>

      <!-- ================= 年度收支 ================= -->
      <block wx:else>
        <!-- 年度账单卡：标题右侧即切换年份入口，去掉页面上方单独一条年份选择条 -->
        <view class="bill-card">
          <view class="bill-card__glow"></view>

          <view class="bill-card__head">
            <text class="bill-card__title">{{ year }} 年度账单</text>
            <view
              class="bill-card__switch"
              bind:tap="openYearPicker"
              hover-class="bill-card__switch--hover"
              aria-role="button"
              aria-label="切换年份，当前 {{ year }} 年"
            >
              <text class="bill-card__switch-text">切换年份</text>
              <ms-icon name="arrow-down" size="22rpx" color="#0b5c3d" />
            </view>
          </view>

          <block wx:if="{{ totals }}">
            <view class="bill-card__hero">
              <text class="bill-card__hero-label">期末结余（元）</text>
              <text class="bill-card__hero-value {{ totals.balanceNegative ? 'is-negative' : '' }}">{{ totals.balanceText }}</text>
            </view>

            <view class="bill-card__flow">
              <view class="bill-card__item">
                <text class="bill-card__item-label">年总收入</text>
                <text class="bill-card__item-value is-income">{{ totals.incomeText }}</text>
              </view>
              <view class="bill-card__item bill-card__item--right">
                <text class="bill-card__item-label">年总支出</text>
                <text class="bill-card__item-value is-expense">{{ totals.expenseText }}</text>
              </view>
            </view>
          </block>

          <view class="bill-card__empty" wx:else>
            <text class="bill-card__empty-text">{{ yearError ? '账单加载失败，可切换年份后重试' : (yearLoaded ? '本年暂无公开账单，可切换年份查看' : '正在加载…') }}</text>
          </view>
        </view>

        <!-- 月度明细：本月收入 / 本月支出 / 期末结余；点开卡片查看该月收支明细 -->
        <view class="section" wx:if="{{ months.length > 0 }}">
          <view class="section__head">
            <view class="section__bar"></view>
            <text class="section__title">月度明细</text>
            <text class="section__extra">已公开 {{ months.length }} 个月</text>
          </view>

          <view
            class="month"
            wx:for="{{ months }}"
            wx:key="month"
            data-index="{{ index }}"
            bind:tap="openMonthDetail"
            hover-class="month--hover"
            aria-role="button"
            aria-label="查看 {{ item.monthText }} 收支明细"
          >
            <view class="month__head">
              <text class="month__name">{{ item.monthText }}</text>
              <view class="month__more">
                <text class="month__more-text">查看明细</text>
                <ms-icon name="arrow" size="20rpx" color="#8f939a" />
              </view>
            </view>

            <view class="month__row">
              <view class="mstat">
                <text class="mstat__label">本月收入</text>
                <text class="mstat__value is-income">{{ item.incomeText }}</text>
              </view>
              <view class="mstat">
                <text class="mstat__label">本月支出</text>
                <text class="mstat__value is-expense">{{ item.expenseText }}</text>
              </view>
              <view class="mstat">
                <text class="mstat__label">期末结余</text>
                <text class="mstat__value {{ item.currentNegative ? 'is-negative' : '' }}">{{ item.currentText }}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="skeleton" wx:elif="{{ !yearLoaded }}">
          <view class="skeleton__row"></view>
          <view class="skeleton__row"></view>
          <view class="skeleton__row"></view>
        </view>
      </block>

      <view class="notice">
        <ms-icon name="passed" size="24rpx" color="#5d9a80" />
        <text class="notice__text">数据由场所按月上报，经审核后公开，接受社会监督</text>
      </view>
    </view>
  </ms-tabs>
</page-main>

<!-- 选择年份：只列该场所已公开账期所在的年份，点选即切换 -->
<ms-action-sheet show="{{ periodsShow }}" title="选择年份" bind:close="closePeriods">
  <view class="periods periods--year">
    <block wx:if="{{ periodState === 'ready' }}">
      <view class="periods__state" wx:if="{{ yearOptions.length === 0 }}">
        <text class="periods__state-text">该场所暂无公开账期</text>
      </view>

      <!-- 年份：只列有已公开账期的年份，副文案统一是"已公开" -->
      <view class="ps-years" wx:else>
        <view
          class="ps-chip ps-chip--year {{ item.year == year ? 'is-active' : '' }}"
          wx:for="{{ yearOptions }}"
          wx:key="year"
          data-year="{{ item.year }}"
          bind:tap="selectYear"
          hover-class="ps-chip--hover"
          aria-role="button"
          aria-label="选择 {{ item.year }} 年"
        >
          <text class="ps-chip__label">{{ item.year }} 年</text>
          <text class="ps-chip__tag">已公开</text>
        </view>
      </view>
    </block>

    <view class="periods__state" wx:elif="{{ periodState === 'loading' }}">正在加载账期…</view>

    <view class="periods__state" wx:else>
      <text class="periods__state-text">账期加载失败</text>
      <view class="periods__retry" bind:tap="loadPeriods" hover-class="periods__retry--hover" aria-role="button" aria-label="重新加载账期">重新加载</view>
    </view>
  </view>
</ms-action-sheet>

<!-- 月度明细抽屉：年度页点开某个月份卡片后，从底部展开该月收支明细 -->
<ms-popup
  show="{{ detailShow }}"
  position="bottom"
  round
  draggable
  drag-zone="{{ 96 }}"
  z-index="{{ 1200 }}"
  bind:close="closeMonthDetail"
  custom-style="height: 78vh; background: #f4faf6; overflow: hidden;"
>
  <view class="sheet">
    <!-- 抓手即下拉关闭手柄：data-drag 让弹层只在按到这里时才接管手势 -->
    <view class="sheet__handle" data-drag="1" hover-class="sheet__handle--hover" hover-stay-time="80" aria-role="button" aria-label="下拉关闭明细"></view>

    <view class="sheet__head">
      <view class="sheet__arrow {{ detailPrev ? '' : 'is-disabled' }}" data-step="-1" bind:tap="switchMonthDetail" aria-role="button" aria-label="上一月">
        <ms-icon name="arrow-left" size="26rpx" color="{{ detailPrev ? '#0a7d59' : '#c9d3ce' }}" />
      </view>

      <view class="sheet__title-box">
        <text class="sheet__title">{{ detailMonthText }}</text>
        <text class="sheet__sub">{{ detailSub }}</text>
      </view>

      <view class="sheet__arrow {{ detailNext ? '' : 'is-disabled' }}" data-step="1" bind:tap="switchMonthDetail" aria-role="button" aria-label="下一月">
        <ms-icon name="arrow" size="26rpx" color="{{ detailNext ? '#0a7d59' : '#c9d3ce' }}" />
      </view>

      <view class="sheet__close" bind:tap="closeMonthDetail" hover-class="sheet__close--hover" aria-role="button" aria-label="关闭明细">
        <ms-icon name="cross" size="36rpx" color="#8d968f" />
      </view>
    </view>

    <!-- 该月合计：与卡片上的三个数值一致，作为明细的汇总口径 -->
    <view class="sheet__summary" wx:if="{{ detailState === 'ready' && detailBill }}">
      <view class="mstat">
        <text class="mstat__label">本月收入</text>
        <text class="mstat__value is-income">{{ detailBill.incomeText }}</text>
      </view>
      <view class="mstat">
        <text class="mstat__label">本月支出</text>
        <text class="mstat__value is-expense">{{ detailBill.expenseText }}</text>
      </view>
      <view class="mstat">
        <text class="mstat__label">期末结余</text>
        <text class="mstat__value {{ detailBill.currentNegative ? 'is-negative' : '' }}">{{ detailBill.currentText }}</text>
      </view>
    </view>

    <scroll-view scroll-y scroll-top="{{ detailScrollTop }}" class="sheet__scroll" wx:if="{{ detailState === 'ready' }}">
      <block wx:if="{{ detailGroups.length > 0 }}">
        <view class="day" wx:for="{{ detailGroups }}" wx:key="date">
          <view class="day__head">
            <view class="day__date">
              <view class="day__dot"></view>
              <text>{{ item.label }}</text>
            </view>
          </view>

          <view class="day__card">
            <view class="bill" wx:for="{{ item.items }}" wx:for-item="row" wx:key="id">
              <view class="bill__icon {{ row.kind === 'expense' ? 'is-expense' : 'is-income' }}">
                <text class="bill__glyph">{{ row.kind === 'expense' ? '−' : '+' }}</text>
              </view>
              <view class="bill__body">
                <text class="bill__summary">{{ row.summary || '未填写摘要' }}</text>
                <text class="bill__sub">{{ row.kindText }}</text>
              </view>
              <text class="bill__amount {{ row.kind === 'expense' ? 'is-expense' : 'is-income' }}">{{ row.amountText }}</text>
            </view>
          </view>
        </view>
      </block>

      <view class="sheet__empty" wx:else>
        <ms-empty description="{{ detailBill ? '该月无收支明细' : '该月暂无公开数据' }}" />
      </view>

      <view class="sheet__notice">
        <ms-icon name="passed" size="22rpx" color="#5d9a80" />
        <text class="sheet__notice-text">明细由场所按月上报，经审核后公开</text>
      </view>
    </scroll-view>

    <view class="sheet__loading" wx:elif="{{ detailState === 'loading' }}">
      <view class="skeleton__row"></view>
      <view class="skeleton__row"></view>
      <view class="skeleton__row"></view>
    </view>

    <view class="sheet__error" wx:else>
      <text class="sheet__error-text">明细加载失败，请重试</text>
      <view class="sheet__retry" bind:tap="retryMonthDetail" hover-class="sheet__retry--hover" aria-role="button" aria-label="重新加载明细">重新加载</view>
    </view>
  </view>
</ms-popup>
