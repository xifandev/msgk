<page-main theme="green" title="财务公开" title1="收支公开透明化" title2="阳光监督新举措">
  <ms-tabs tabs="{{ ['月度收支', '年度收支'] }}" active="{{ active }}" animated swipeable color="#0a7d59" bind:change="onTabChange">
    <view class="pane">
      <!-- ================= 月度收支 ================= -->
      <block wx:if="{{ active === 0 }}">
        <view class="period" bind:tap="openMonthPicker" hover-class="period--hover" aria-role="button" aria-label="切换月份">
          <view class="period__left">
            <ms-icon name="calendar" size="30rpx" color="#0a7d59" />
            <text class="period__text">{{ monthText }}</text>
          </view>
          <view class="period__right">
            <text>切换月份</text>
            <ms-icon name="arrow-down" size="22rpx" color="#9a9ca1" />
          </view>
        </view>

        <block wx:if="{{ monthLoaded && bill }}">
          <!-- 结余主卡 -->
          <view class="balance">
            <view class="balance__glow"></view>
            <view class="balance__sheen"></view>
            <view class="balance__top">
              <text class="balance__label">本月结余（元）</text>
              <view class="balance__delta {{ bill.deltaFlat ? 'is-flat' : (bill.deltaUp ? 'is-up' : 'is-down') }}">
                <text class="balance__delta-arrow" wx:if="{{ !bill.deltaFlat }}">{{ bill.deltaUp ? '↑' : '↓' }}</text>
                <text>{{ bill.deltaText }}</text>
              </view>
            </view>
            <view class="balance__value">{{ bill.currentText }}</view>

            <view class="balance__flow">
              <view class="flow">
                <text class="flow__label">上月结余</text>
                <text class="flow__value">{{ bill.previousText }}</text>
              </view>
              <view class="flow__split"></view>
              <view class="flow">
                <text class="flow__label">本月收入</text>
                <text class="flow__value">{{ bill.incomeText }}</text>
              </view>
              <view class="flow__split"></view>
              <view class="flow">
                <text class="flow__label">本月支出</text>
                <text class="flow__value">{{ bill.expenseText }}</text>
              </view>
            </view>

            <view class="ratio" wx:if="{{ bill.hasFlow }}">
              <view class="ratio__bar">
                <view class="ratio__income" style="width:{{ bill.incomePercent }}%"></view>
                <view class="ratio__expense" style="width:{{ bill.expensePercent }}%"></view>
              </view>
              <view class="ratio__legend">
                <view class="ratio__legend-item">
                  <view class="dot dot--income"></view>
                  <text>收入 {{ bill.incomePercent }}%</text>
                </view>
                <view class="ratio__legend-item">
                  <view class="dot dot--expense"></view>
                  <text>支出 {{ bill.expensePercent }}%</text>
                </view>
              </view>
            </view>
          </view>

          <!-- 明细 -->
          <view class="section" wx:if="{{ items.length > 0 }}">
            <view class="section__head">
              <view class="section__bar"></view>
              <text class="section__title">收支明细</text>
              <text class="section__extra">共 {{ items.length }} 笔</text>
            </view>

            <view class="day" wx:for="{{ groups }}" wx:key="date">
              <view class="day__head">
                <view class="day__date">
                  <view class="day__dot"></view>
                  <text>{{ item.label }}</text>
                </view>
                <view class="day__sum">
                  <text wx:if="{{ item.incomeText }}">收入 {{ item.incomeText }}</text>
                  <text wx:if="{{ item.expenseText }}">支出 {{ item.expenseText }}</text>
                </view>
              </view>

              <view class="day__card">
                <view class="bill" wx:for="{{ item.items }}" wx:for-item="row" wx:key="id">
                  <view class="bill__icon {{ row.kind === 'expense' ? 'is-expense' : 'is-income' }}">
                    <text class="bill__glyph">{{ row.kind === 'expense' ? '−' : '+' }}</text>
                  </view>
                  <view class="bill__body">
                    <text class="bill__summary">{{ row.summary || '未填写摘要' }}</text>
                    <text class="bill__sub">{{ row.kindText }}</text>
                  </view>
                  <text class="bill__amount {{ row.kind === 'expense' ? 'is-expense' : 'is-income' }}">{{ row.amountText }}</text>
                </view>
              </view>
            </view>
          </view>

          <view class="empty-card" wx:else>
            <ms-empty description="本月暂无公开明细">
              <text class="empty-card__hint">收支明细由场所按月报送，审核通过后公开</text>
            </ms-empty>
          </view>
        </block>

        <view class="empty-card" wx:elif="{{ monthLoaded && !bill }}">
          <ms-empty description="本月暂无公开数据">
            <text class="empty-card__hint">可切换月份查看历史公开记录</text>
          </ms-empty>
        </view>
        <view class="skeleton" wx:else>
          <view class="skeleton__hero"></view>
          <view class="skeleton__row"></view>
          <view class="skeleton__row"></view>
        </view>
      </block>

      <!-- ================= 年度收支 ================= -->
      <block wx:else>
        <view class="period" bind:tap="openYearPicker" hover-class="period--hover" aria-role="button" aria-label="切换年份">
          <view class="period__left">
            <ms-icon name="calendar" size="30rpx" color="#0a7d59" />
            <text class="period__text">{{ year }} 年</text>
          </view>
          <view class="period__right">
            <text>切换年份</text>
            <ms-icon name="arrow-down" size="22rpx" color="#9a9ca1" />
          </view>
        </view>

        <block wx:if="{{ yearLoaded && months.length > 0 }}">
          <!-- 年度账单卡 -->
          <view class="year">
            <view class="year__head">
              <view>
                <text class="year__title">{{ year }} 年度账单</text>
                <text class="year__sub">共 {{ months.length }} 个月有公开数据</text>
              </view>
              <view class="year__badge">
                <ms-icon name="chart-bar" size="34rpx" color="#ffffff" />
              </view>
            </view>

            <view class="year__totals" wx:if="{{ totals }}">
              <view class="total">
                <text class="total__label">总收入</text>
                <text class="total__value is-income">{{ totals.incomeText }}</text>
              </view>
              <view class="total">
                <text class="total__label">总支出</text>
                <text class="total__value is-expense">{{ totals.expenseText }}</text>
              </view>
              <view class="total">
                <text class="total__label">期末结余</text>
                <text class="total__value">{{ totals.balanceText }}</text>
              </view>
            </view>

            <!-- 月度柱状对比 -->
            <view class="chart">
              <view class="chart__grid">
                <view class="chart__line"></view>
                <view class="chart__line"></view>
                <view class="chart__line"></view>
              </view>
              <view class="chart__cols">
                <view class="chart__col" wx:for="{{ chart }}" wx:key="month">
                  <view class="chart__bars">
                    <view class="chart__bar chart__bar--income" style="height:{{ item.incomeHeight }}%"></view>
                    <view class="chart__bar chart__bar--expense" style="height:{{ item.expenseHeight }}%"></view>
                  </view>
                  <text class="chart__label">{{ item.label }}</text>
                </view>
              </view>
            </view>
            <view class="chart__legend">
              <view class="legend"><view class="dot dot--income"></view><text>收入</text></view>
              <view class="legend"><view class="dot dot--expense"></view><text>支出</text></view>
            </view>
          </view>

          <!-- 月度明细 -->
          <view class="section">
            <view class="section__head">
              <view class="section__bar"></view>
              <text class="section__title">月度明细</text>
            </view>

            <view class="month" wx:for="{{ months }}" wx:key="month">
              <view class="month__head">
                <text class="month__name">{{ item.monthText }}</text>
                <view class="month__balance">
                  <text>本月结余</text>
                  <text class="month__balance-value">{{ item.currentText }}</text>
                </view>
              </view>

              <view class="month__row">
                <view class="mstat">
                  <text class="mstat__label">收入</text>
                  <text class="mstat__value is-income">{{ item.incomeText }}</text>
                </view>
                <view class="mstat">
                  <text class="mstat__label">支出</text>
                  <text class="mstat__value is-expense">{{ item.expenseText }}</text>
                </view>
                <view class="mstat">
                  <text class="mstat__label">上月结余</text>
                  <text class="mstat__value">{{ item.previousText }}</text>
                </view>
              </view>

              <view class="month__bar">
                <view class="month__bar-income" style="width:{{ item.incomeWidth }}%"></view>
                <view class="month__bar-expense" style="width:{{ item.expenseWidth }}%"></view>
              </view>
            </view>
          </view>
        </block>

        <view class="empty-card" wx:elif="{{ yearLoaded && months.length === 0 }}">
          <ms-empty description="本年暂无公开数据">
            <text class="empty-card__hint">可切换年份查看历史公开记录</text>
          </ms-empty>
        </view>
        <view class="skeleton" wx:else>
          <view class="skeleton__hero"></view>
          <view class="skeleton__row"></view>
          <view class="skeleton__row"></view>
        </view>
      </block>

      <view class="notice">
        <ms-icon name="passed" size="24rpx" color="#5d9a80" />
        <text class="notice__text">数据由场所按月报送，经审核后公开，接受社会监督</text>
      </view>
    </view>
  </ms-tabs>
</page-main>

<!-- 选择年月 -->
<ms-action-sheet show="{{ monthPickerShow }}" title="选择年月" bind:close="closeMonthPicker">
  <ms-datetime-picker type="year-month" value="{{ currentDate }}" min-date="{{ minDate }}" max-date="{{ maxDate }}" bind:input="onMonthInput" bind:confirm="confirmMonth" bind:cancel="closeMonthPicker" />
</ms-action-sheet>

<!-- 选择年份 -->
<ms-action-sheet show="{{ yearPickerShow }}" title="选择年份" bind:close="closeYearPicker">
  <ms-picker columns="{{ yearColumns }}" default-index="{{ yearDefaultIndex }}" bind:confirm="confirmYear" bind:cancel="closeYearPicker" bind:change="onYearChange" />
</ms-action-sheet>
