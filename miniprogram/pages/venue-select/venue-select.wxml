<view class="page">

  <!-- 沉浸式页头：按状态栏高度留出安全区 -->
  <view class="hero" style="padding-top:{{ statusBarHeight + 10 }}px">
    <view class="hero__glow hero__glow--one"></view>
    <view class="hero__glow hero__glow--two"></view>
    <view class="hero__mark">
      <ms-icon name="building" size="150rpx" color="rgba(255,255,255,0.13)" />
    </view>

    <view class="hero__nav">
      <view
        class="hero__back"
        hover-class="hero__back--hover"
        bind:tap="goBack"
        aria-role="button"
        aria-label="返回首页"
      >
        <ms-icon name="arrow-left" size="34rpx" color="#ffffff" />
      </view>
    </view>

    <view class="hero__title">请选择场所</view>
    <view class="hero__sub" wx:if="{{ !loading }}">共 {{ total }} 个场所 · {{ townshipCount }} 个乡镇</view>
    <view class="hero__sub" wx:else>正在获取场所数据</view>
  </view>

  <!-- 悬浮搜索卡 -->
  <view class="search-card">
    <ms-icon name="search" size="34rpx" color="#969799" />
    <input
      class="search-card__input"
      value="{{ keyword }}"
      placeholder="搜索场所名称或乡镇"
      placeholder-class="search-card__placeholder"
      confirm-type="search"
      bindinput="onSearch"
    />
    <view
      wx:if="{{ keyword }}"
      class="search-card__clear"
      bind:tap="clearSearch"
      aria-role="button"
      aria-label="清空搜索"
    >
      <ms-icon name="cross" size="22rpx" color="#ffffff" />
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{ loading }}" class="state">
    <ms-loading text="正在加载场所" color="#d31027" size="48rpx" />
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{ loadError }}" class="state">
    <ms-empty description="场所数据加载失败" />
    <view class="retry-btn" hover-class="retry-btn--hover" bind:tap="load" aria-role="button">
      重新加载
    </view>
  </view>

  <!-- 搜索结果 -->
  <block wx:elif="{{ keyword }}">
    <view wx:if="{{ results.length === 0 }}" class="state">
      <ms-empty description="没有匹配的场所" />
      <view class="state__tip">换个关键词试试，或清空搜索按乡镇浏览</view>
    </view>
    <view wx:else class="result-list">
      <view
        class="venue"
        wx:for="{{ results }}"
        wx:key="id"
        data-id="{{ item.id }}"
        bind:tap="onPick"
        hover-class="venue--hover"
        aria-role="button"
        aria-label="选择场所 {{ item.name }}"
      >
        <view class="venue__avatar">
          <ms-icon name="building" size="36rpx" color="#d31027" />
        </view>
        <view class="venue__body">
          <view class="venue__name">
            <block wx:for="{{ item.segs }}" wx:for-item="seg" wx:key="i">
              <text class="{{ seg.hit ? 'is-hit' : '' }}">{{ seg.t }}</text>
            </block>
          </view>
          <view class="venue__town">
            <view class="venue__town-icon"><ms-icon name="location" size="24rpx" color="#b0b3b8" /></view>
            <text>{{ item.township }}</text>
          </view>
        </view>
      </view>
      <view class="list-end" wx:if="{{ results.length >= 50 }}">仅显示前 50 条，请细化关键词</view>
    </view>
  </block>

  <!-- 浏览模式：按乡镇分组的场所列表 -->
  <block wx:else>
    <view wx:if="{{ sections.length === 0 }}" class="state">
      <ms-empty description="暂无场所数据" />
    </view>

    <view wx:for="{{ sections }}" wx:key="id" wx:for-item="group" class="section">
      <view class="section__head" id="{{ group.id }}">
        <view class="section__dot"></view>
        <text class="section__name">{{ group.text }}</text>
        <text class="section__count">{{ group.count }} 个场所</text>
      </view>
      <view class="section__body">
        <view
          class="venue"
          wx:for="{{ group.children }}"
          wx:for-item="v"
          wx:key="id"
          data-id="{{ v.id }}"
          bind:tap="onPick"
          hover-class="venue--hover"
          aria-role="button"
          aria-label="选择场所 {{ v.label }}"
        >
          <view class="venue__avatar">
            <ms-icon name="building" size="36rpx" color="#d31027" />
          </view>
          <view class="venue__body">
            <view class="venue__name">{{ v.label }}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="list-end" wx:if="{{ sections.length > 0 }}">— 已展示全部场所 —</view>
  </block>

  <!-- 场所切换：先载入，再显示完成 -->
  <view
    class="switch"
    wx:if="{{ switching }}"
    aria-role="status"
    aria-label="{{ switchDone ? '场所载入完成' : '场所数据载入中' }}"
  >
    <view class="switch__card">
      <view class="switch__visual">
        <view wx:if="{{ !switchDone }}" class="switch__loader"></view>
        <view wx:else class="switch__success">
          <ms-icon name="passed" size="48rpx" color="#4f876d" />
        </view>
      </view>
      <view class="switch__text">{{ switchDone ? '场所载入完成' : '场所数据载入中' }}</view>
    </view>
  </view>
</view>
