<view class="page">

  <!-- 沉浸式页头 -->
  <view class="hero">
    <view class="hero__glow hero__glow--one"></view>
    <view class="hero__glow hero__glow--two"></view>
    <view class="hero__mark">
      <ms-icon name="building" size="160rpx" color="rgba(255,255,255,0.14)" />
    </view>

    <view class="hero__nav">
      <view
        class="hero__back"
        hover-class="hero__back--hover"
        bind:tap="goBack"
        aria-role="button"
        aria-label="返回首页"
      >
        <ms-icon name="arrow" size="34rpx" color="#ffffff" />
      </view>
    </view>

    <view class="hero__title">选择场所</view>
    <view class="hero__sub" wx:if="{{ !loading }}">共 {{ total }} 个场所 · {{ townshipCount }} 个乡镇</view>
    <view class="hero__sub" wx:else>正在获取场所数据</view>
  </view>

  <!-- 悬浮搜索卡 -->
  <view class="search-card">
    <ms-icon name="search" size="32rpx" color="#969799" />
    <input
      class="search-card__input"
      value="{{ keyword }}"
      placeholder="搜索场所名称或乡镇"
      placeholder-class="search-card__placeholder"
      confirm-type="search"
      bindinput="onSearch"
    />
    <view
      wx:if="{{ keyword }}"
      class="search-card__clear"
      bind:tap="clearSearch"
      aria-role="button"
      aria-label="清空搜索"
    >
      <ms-icon name="cross" size="22rpx" color="#ffffff" />
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{ loading }}" class="state">
    <ms-loading text="正在加载场所" color="#d31027" size="48rpx" />
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{ loadError }}" class="state">
    <ms-empty description="场所数据加载失败" />
    <view class="retry-btn" hover-class="retry-btn--hover" bind:tap="load" aria-role="button">
      重新加载
    </view>
  </view>

  <!-- 搜索结果 -->
  <block wx:elif="{{ keyword }}">
    <view wx:if="{{ results.length === 0 }}" class="state">
      <ms-empty description="没有匹配的场所" />
      <view class="state__tip">换个关键词试试，或清空搜索按乡镇浏览</view>
    </view>
    <view wx:else class="result-list">
      <view
        class="venue {{ item.id == current.id ? 'is-active' : '' }}"
        wx:for="{{ results }}"
        wx:key="id"
        data-id="{{ item.id }}"
        bind:tap="onPick"
        hover-class="venue--hover"
        aria-role="button"
        aria-label="选择场所"
      >
        <view class="venue__avatar {{ item.id == current.id ? 'is-on' : '' }}">
          <ms-icon name="building" size="34rpx" color="{{ item.id == current.id ? '#ffffff' : '#d31027' }}" />
        </view>
        <view class="venue__body">
          <view class="venue__name">
            <block wx:for="{{ item.segs }}" wx:for-item="seg" wx:key="i">
              <text class="{{ seg.hit ? 'is-hit' : '' }}">{{ seg.t }}</text>
            </block>
          </view>
          <view class="venue__town">
            <view class="venue__town-icon"><ms-icon name="location" size="22rpx" color="#b0b3b8" /></view>
            <text>{{ item.township }}</text>
          </view>
        </view>
        <view wx:if="{{ item.id == current.id }}" class="venue__check">
          <ms-icon name="checked" size="34rpx" color="#d31027" />
        </view>
      </view>
      <view class="list-end" wx:if="{{ results.length >= 50 }}">仅显示前 50 条，请细化关键词</view>
    </view>
  </block>

  <!-- 浏览模式 -->
  <block wx:else>

    <!-- 当前场所 -->
    <view class="current-card" wx:if="{{ current }}">
      <view class="current-card__avatar">
        <ms-icon name="building" size="38rpx" color="#ffffff" />
      </view>
      <view class="current-card__body">
        <view class="current-card__label">当前使用</view>
        <view class="current-card__name">{{ current.name }}</view>
        <view class="current-card__town">
          <view class="current-card__town-icon"><ms-icon name="location" size="22rpx" color="#ea8f95" /></view>
          <text>{{ current.township }}</text>
        </view>
      </view>
      <view class="current-card__tag">
        <ms-icon name="passed" size="24rpx" color="#d31027" />
        <text>已选</text>
      </view>
    </view>

    <!-- 最近选择 -->
    <view class="recent" wx:if="{{ recent.length > 0 }}">
      <view class="recent__title">最近选择</view>
      <scroll-view class="recent__scroll" scroll-x>
        <view class="recent__chips">
          <view
            class="chip"
            wx:for="{{ recent }}"
            wx:key="id"
            data-id="{{ item.id }}"
            bind:tap="onPick"
            hover-class="chip--hover"
            aria-role="button"
            aria-label="选择最近场所 {{ item.name }}"
          >
            <view class="chip__icon"><ms-icon name="location" size="22rpx" color="#d31027" /></view>
            <text class="chip__name">{{ item.name }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 乡镇分组列表 -->
    <view wx:if="{{ sections.length === 0 }}" class="state">
      <ms-empty description="暂无场所数据" />
    </view>

    <view wx:for="{{ sections }}" wx:key="id" wx:for-item="group" class="section">
      <view class="section__head" id="{{ group.id }}">
        <view class="section__dot"></view>
        <text class="section__name">{{ group.text }}</text>
        <text class="section__count">{{ group.count }} 个场所</text>
      </view>
      <view class="section__body">
        <view
          class="venue {{ v.id == current.id ? 'is-active' : '' }}"
          wx:for="{{ group.children }}"
          wx:for-item="v"
          wx:key="id"
          data-id="{{ v.id }}"
          bind:tap="onPick"
          hover-class="venue--hover"
          aria-role="button"
          aria-label="选择场所 {{ v.name }}"
        >
          <view class="venue__avatar {{ v.id == current.id ? 'is-on' : '' }}">
            <ms-icon name="building" size="34rpx" color="{{ v.id == current.id ? '#ffffff' : '#d31027' }}" />
          </view>
          <view class="venue__body">
            <view class="venue__name">{{ v.name }}</view>
            <view class="venue__town">
              <view class="venue__town-icon"><ms-icon name="location" size="22rpx" color="#b0b3b8" /></view>
              <text>{{ v.township }}</text>
            </view>
          </view>
          <view wx:if="{{ v.id == current.id }}" class="venue__check">
            <ms-icon name="checked" size="34rpx" color="#d31027" />
          </view>
        </view>
      </view>
    </view>

    <view class="list-end" wx:if="{{ sections.length > 0 }}">— 已展示全部场所 —</view>
  </block>

  <!-- 乡镇索引（右侧快捷导航） -->
  <view class="rail" wx:if="{{ !keyword && !loading && sections.length > 0 }}">
    <view
      class="rail__item {{ activeRail === index ? 'is-active' : '' }}"
      wx:for="{{ rail }}"
      wx:key="index"
      data-index="{{ index }}"
      bind:tap="onRailTap"
      aria-role="button"
      aria-label="跳转到分组 {{ item.label }}"
    >{{ item.label }}</view>
  </view>
</view>
