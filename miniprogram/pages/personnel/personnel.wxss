/* 人员公开页（沿用旧版类名与数值，px/rpx 单位与旧版一致） */

/* 头像：旧版宽 190rpx / 圆角 10px，新版固定宽高 + aspectFill */
.touxiang {
  width: 190rpx;
  height: 190rpx;
  border-radius: 10px;
  flex-shrink: 0;
}

/* 无头像时灰底占位 */
.touxiang--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f2f3f5;
}

.box {
  display: flex;
  justify-items: center;
  align-items: center;
}

.name {
  margin-left: 15px;
  font-size: 20px;
  font-weight: bolder;
  margin-bottom: 5px;
  margin-top: 5px;
}

.zhiwu {
  margin-left: 15px;
  font-size: 15px;
  color: #999;
  overflow: hidden;
}

.zhiwei {
  margin-left: 15px;
  font-size: 15px;
  color: #999;
  overflow: hidden;
}
