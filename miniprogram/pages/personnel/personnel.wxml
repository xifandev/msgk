<page-main title="管理组织及人员情况" title1="公开监督新举措" title2="透明管理新模式">
  <ms-cell-group>
    <view style="height:20rpx"></view>

    <!-- 加载中 -->
    <ms-loading wx:if="{{ !loaded }}" text="正在加载" />

    <!-- 空态 -->
    <ms-empty wx:elif="{{ members.length === 0 }}" description="暂未公开" />

    <!-- 成员列表：竖版证件照 + 姓名 + 职务/教职标签 -->
    <ms-cell wx:for="{{ members }}" wx:key="index">
      <view slot="title" class="member">
        <image
          wx:if="{{ item.imageUrl }}"
          class="member__photo"
          src="{{ item.imageUrl }}"
          mode="aspectFill"
        />
        <view wx:else class="member__photo member__photo--fallback">
          <ms-icon name="contact" size="72rpx" color="#c8c9cc" />
        </view>
        <view class="member__info">
          <view class="member__name">{{ item.name }}</view>
          <view class="member__tags" wx:if="{{ item.positions.length || item.clergies.length }}">
            <text
              wx:for="{{ item.positions }}"
              wx:for-item="tag"
              wx:key="index"
              class="member__tag member__tag--position"
            >{{ tag }}</text>
            <text
              wx:for="{{ item.clergies }}"
              wx:for-item="tag"
              wx:key="index"
              class="member__tag member__tag--clergy"
            >{{ tag }}</text>
          </view>
          <view wx:if="{{ item.phone }}" class="member__phone">
            <ms-icon name="phone" size="24rpx" color="#b3b6bb" />
            <text>{{ item.phone }}</text>
          </view>
        </view>
      </view>
    </ms-cell>
  </ms-cell-group>
</page-main>
