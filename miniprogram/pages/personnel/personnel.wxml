<page-main title="管理组织及人员情况" title1="公开监督新举措" title2="透明管理新模式">
  <ms-cell-group>
    <view style="height:20rpx"></view>

    <!-- 加载中 -->
    <ms-loading wx:if="{{ !loaded }}" text="正在加载" />

    <!-- 空态 -->
    <ms-empty wx:elif="{{ members.length === 0 }}" description="暂未公开" />

    <!-- 成员列表（旧版 .box 布局） -->
    <ms-cell wx:for="{{ members }}" wx:key="index">
      <view slot="title" class="box">
        <image
          wx:if="{{ item.imageUrl }}"
          class="touxiang"
          src="{{ item.imageUrl }}"
          mode="aspectFill"
        />
        <view wx:else class="touxiang touxiang--fallback">
          <ms-icon name="contact" size="80rpx" color="#c8c9cc" />
        </view>
        <view>
          <view class="name">{{ item.name }}</view>
          <view class="zhiwu" wx:if="{{ item.clergy || item.position }}">
            {{ item.clergy }} {{ item.position }}
          </view>
          <view class="zhiwei" wx:if="{{ item.phone }}" bind:tap="callPhone" data-phone="{{ item.phone }}">
            电话:{{ item.phone }}
          </view>
        </view>
      </view>
    </ms-cell>
  </ms-cell-group>
</page-main>
