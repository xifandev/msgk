.ms-tabs {
  width: 100%;
  background-color: #fff;
}

.ms-tabs__nav {
  position: relative;
  display: flex;
  align-items: stretch;
  height: 88rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #ebedf0;
}

.ms-tabs__nav.is-scrollable {
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

/* 吸顶模式：标题栏相对 page-main 内的 scroll-view 固定，内容从其下方滚过。
   z-index 保证标题栏压在内容之上；父级链上不能出现 overflow/transform，否则 sticky 失效 */
.ms-tabs.is-sticky .ms-tabs__nav {
  position: sticky;
  top: 0;
  z-index: 20;
}

.ms-tabs__item {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  font-size: 28rpx;
  color: #646566;
}

.ms-tabs__nav.is-scrollable .ms-tabs__item {
  /* 不压缩、可伸展：内容总宽小于整屏时均分铺满，超出时横向滚动，标题不会折行 */
  flex: 1 0 auto;
  min-width: 0;
  padding: 0 20rpx;
}

.ms-tabs__item.is-active {
  font-weight: 500;
}

.ms-tabs__text {
  max-width: 100%;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ms-tabs__text.is-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ms-tabs__line {
  position: absolute;
  bottom: 0;
  left: 50%;
  height: 6rpx;
  border-radius: 6rpx;
  transform: translateX(-50%);
  transition: width 0.2s ease;
}

.ms-tabs__body {
  position: relative;
}
