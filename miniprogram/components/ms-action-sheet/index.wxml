<ms-popup show="{{ show }}" position="bottom" round z-index="{{ 1100 }}" close-on-click-overlay="{{ closeOnClickOverlay }}" bind:close="onClose">
  <view class="ms-action-sheet {{ showHeader ? '' : 'ms-action-sheet--plain' }}">
    <view class="ms-action-sheet__header" wx:if="{{ showHeader }}">
      <view class="ms-action-sheet__title">{{ title }}</view>
      <view class="ms-action-sheet__close" bind:tap="onClose" hover-class="ms-action-sheet__close--hover">
        <ms-icon name="cross" size="32rpx" color="#c8c9cc" />
      </view>
    </view>
    <view class="ms-action-sheet__plain-close" wx:else bind:tap="onClose" hover-class="ms-action-sheet__close--hover">
      <ms-icon name="cross" size="32rpx" color="#c8c9cc" />
    </view>
    <view class="ms-action-sheet__body">
      <slot></slot>
    </view>
  </view>
</ms-popup>
