.ms-action-sheet {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.ms-action-sheet--plain {
  position: relative;
}

.ms-action-sheet__plain-close {
  position: absolute;
  right: 16rpx;
  top: 12rpx;
  z-index: 2;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ms-action-sheet__header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  flex-shrink: 0;
}

.ms-action-sheet__title {
  font-size: 30rpx;
  font-weight: 500;
  color: #323233;
  padding: 0 80rpx;
  text-align: center;
}

.ms-action-sheet__close {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ms-action-sheet__close--hover {
  opacity: 0.6;
}

.ms-action-sheet__body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
