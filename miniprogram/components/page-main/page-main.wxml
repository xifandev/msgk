<view class="bgc"></view>
<view class="top-box">
  <view class="top-title">{{ title }}</view>
  <view class="top-title2">
    <view class="top-title2-item" wx:if="{{ title1 }}">
      <ms-icon name="passed" size="26rpx" color="rgba(255,255,255,0.85)" />
      <text>{{ title1 }}</text>
    </view>
    <view class="top-title2-item" wx:if="{{ title2 }}">
      <ms-icon name="passed" size="26rpx" color="rgba(255,255,255,0.85)" />
      <text>{{ title2 }}</text>
    </view>
    <view class="top-title2-item" wx:if="{{ title3 }}">
      <ms-icon name="passed" size="26rpx" color="rgba(255,255,255,0.85)" />
      <text>{{ title3 }}</text>
    </view>
  </view>
</view>
<view class="cellgroup">
  <scroll-view scroll-y class="cellgroup__scroll" bindscrolltolower="onScrollToLower" lower-threshold="80">
    <slot></slot>
    <view class="bottom-gap"></view>
  </scroll-view>
</view>
