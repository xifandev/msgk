.bgc {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 22%, #f1f2f4 70%);
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
}

.top-box {
  width: 100vw;
  position: relative;
  overflow: hidden;
}

.top-title {
  font-size: 50rpx;
  color: #fff;
  padding-top: 30rpx;
  margin-left: 40rpx;
  font-weight: bold;
  line-height: 1.3;
}

.top-title2 {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 10rpx;
  margin-left: 40rpx;
  margin-bottom: 43rpx;
  display: flex;
  flex-wrap: wrap;
}

.top-title2-item {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.top-title2-item text {
  padding-left: 8rpx;
}

.cellgroup {
  margin: 0 32rpx;
  border-radius: 16rpx;
  background-color: #fff;
  overflow: hidden;
}

.cellgroup__scroll {
  height: 85vh;
  background-color: #fff;
}

.bottom-gap {
  height: 100rpx;
}
