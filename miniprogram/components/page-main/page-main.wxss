:host {
  display: block;
}

/* 整体：纵向 flex，页头固定高度 + 白色内容区撑满剩余空间（滚动在内容区内部进行） */
.pm {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.bgc {
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
  overflow: hidden;
}

/* 默认主题：红 */
.bgc--red {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 22%, #f1f2f4 70%);
}

/* 绿色主题：阳光绿渐变（左上嫩绿 → 右下翠绿），纵向淡出到页面底色；
   右上叠一圈柔光，营造「阳光公示」的通透感 */
.bgc--green {
  background:
    linear-gradient(180deg, rgba(244, 250, 246, 0) 0%, rgba(244, 250, 246, 0) 24%, #f4faf6 48%),
    linear-gradient(135deg, #81fbb8 0%, #28c76f 100%);
}

.bgc--green::after {
  content: '';
  position: absolute;
  right: -180rpx;
  top: -220rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 66%);
}

.top-box {
  width: 100vw;
  flex: none;
  position: relative;
  overflow: hidden;
}

/* ---------- 全屏模式的返回按钮行：与右上角胶囊按钮同一行 ---------- */
.fs-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin: 0 40rpx 20rpx;
}

.fs-back {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 红色主题：白色半透明底 + 白色箭头 */
.fs-back--red {
  background: rgba(255, 255, 255, 0.2);
}

.fs-back--red.fs-back--hover {
  background: rgba(255, 255, 255, 0.34);
}

/* 绿色主题：浅色底上用深绿半透明底 + 深绿箭头 */
.fs-back--green {
  background: rgba(12, 90, 56, 0.12);
}

.fs-back--green.fs-back--hover {
  background: rgba(12, 90, 56, 0.22);
}

.top-title {
  font-size: 50rpx;
  color: #fff;
  padding-top: 30rpx;
  margin-left: 40rpx;
  font-weight: bold;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.top-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
  margin-left: 40rpx;
  letter-spacing: 0.5rpx;
}

.top-box--green .top-subtitle {
  color: #386b52;
}

.top-title2 {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 10rpx;
  margin-left: 40rpx;
  margin-bottom: 43rpx;
  display: flex;
  flex-wrap: wrap;
}

.top-title2-item {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.top-title2-item text {
  padding-left: 8rpx;
}

.top-box--green .top-title {
  color: #104c34;
}

.top-box--green .top-title2 {
  color: #236647;
}

/* ---------- 白色内容区 ---------- */
.cellgroup {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin: 0 32rpx;
  /* 先给固定兜底值，再尝试安全区（个别环境不认 env() 时保留兜底） */
  margin-bottom: 24rpx;
  margin-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  border-radius: 16rpx;
  background-color: #fff;
  overflow: hidden;
}

.cellgroup__scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  background-color: #fff;
}

.bottom-gap {
  height: 100rpx;
}
