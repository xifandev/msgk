:host {
  display: block;
}

.pm {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.bgc {
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.bgc--red {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 22%, #f1f2f4 70%);
}

/* 财务公开使用紧凑浅色页头，让首屏优先展示账目 */
.bgc--green {
  background: #f3f6f4;
}

.bgc--green::after {
  display: none;
}

.top-box {
  position: relative;
  flex: none;
  width: 100vw;
  overflow: hidden;
}

.fs-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin: 0 40rpx 20rpx;
}

.fs-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.fs-back--red {
  background: rgba(255, 255, 255, 0.2);
}

.fs-back--red.fs-back--hover {
  background: rgba(255, 255, 255, 0.34);
}

.top-box--green .fs-nav {
  height: 64rpx;
  margin: 0 28rpx 8rpx;
}

.top-box--green .fs-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
}

.fs-back--green {
  background: #e5ece8;
}

.fs-back--green.fs-back--hover {
  background: #d9e4dd;
}

.top-title {
  margin-left: 40rpx;
  padding-top: 30rpx;
  color: #ffffff;
  font-size: 50rpx;
  font-weight: bold;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.top-subtitle {
  margin-top: 8rpx;
  margin-left: 40rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  letter-spacing: 0.5rpx;
}

.top-box--green {
  padding-bottom: 24rpx;
}

.top-box--green .top-title {
  margin-left: 0;
  padding: 8rpx 32rpx 0;
  color: #152b23;
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.25;
  letter-spacing: 0;
}

.top-box--green .top-subtitle {
  display: flex;
  align-items: center;
  max-width: calc(100vw - 64rpx);
  margin: 10rpx 32rpx 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: #74827b;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
  letter-spacing: 0;
}

.top-box--green .top-subtitle text {
  min-width: 0;
}

.top-title2 {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  margin-bottom: 43rpx;
  margin-left: 40rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
}

.top-title2-item {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.top-title2-item text {
  padding-left: 8rpx;
}

.top-box--green .top-title2 {
  color: #61756b;
}

.cellgroup {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin: 0 32rpx;
  margin-bottom: 24rpx;
  margin-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  overflow: hidden;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.top-box--green + .cellgroup {
  margin: 0;
  border-radius: 28rpx 28rpx 0 0;
  background-color: #f5f7f6;
}

.cellgroup__scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  background-color: #ffffff;
}

.top-box--green + .cellgroup .cellgroup__scroll {
  background-color: #f5f7f6;
}

.bottom-gap {
  height: 100rpx;
}
