:host {
  display: block;
}

.pm {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.bgc {
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

.bgc--red {
  background: linear-gradient(180deg, #d31027 0%, #ea384d 22%, #f1f2f4 70%);
}

/* 绿色主题：阳光绿渐变（左上嫩绿 → 右下翠绿），纵向淡出到页面底色；
   右上叠一圈柔光，营造「阳光公示」的通透感 */
.bgc--green {
  background:
    linear-gradient(180deg, rgba(244, 250, 246, 0) 0%, rgba(244, 250, 246, 0) 24%, #f4faf6 48%),
    linear-gradient(135deg, #81fbb8 0%, #28c76f 100%);
}

.bgc--green::after {
  content: '';
  position: absolute;
  top: -220rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 66%);
}

.top-box {
  position: relative;
  flex: none;
  width: 100vw;
  overflow: hidden;
}

.fs-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin: 0 40rpx 20rpx;
}

.fs-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.fs-back--red {
  background: rgba(255, 255, 255, 0.2);
}

.fs-back--red.fs-back--hover {
  background: rgba(255, 255, 255, 0.34);
}

/* 绿色主题：浅色底上用深绿半透明底 + 深绿箭头 */
.fs-back--green {
  background: rgba(12, 90, 56, 0.12);
}

.fs-back--green.fs-back--hover {
  background: rgba(12, 90, 56, 0.22);
}

.top-title {
  margin-left: 40rpx;
  padding-top: 30rpx;
  color: #ffffff;
  font-size: 50rpx;
  font-weight: bold;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.top-subtitle {
  margin-top: 8rpx;
  margin-left: 40rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  letter-spacing: 0.5rpx;
}

.top-box--green {
  padding-bottom: 20rpx;
}

.top-box--green .top-title {
  color: #104c34;
}

/* 绿色主题下副标题作为页面身份标识（当前用于财务公开的场所名） */
.top-box--green .top-subtitle {
  display: flex;
  align-items: center;
  max-width: calc(100vw - 80rpx);
  margin-top: 14rpx;
  margin-right: 40rpx;
  padding: 12rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: 0 6rpx 18rpx rgba(12, 90, 56, 0.08);
  box-sizing: border-box;
  color: #0c5a38;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 0.8rpx;
}

.top-box--green .top-subtitle text {
  min-width: 0;
}

.top-title2 {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
  margin-bottom: 43rpx;
  margin-left: 40rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 28rpx;
}

.top-title2-item {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.top-title2-item text {
  padding-left: 8rpx;
}

.top-box--green .top-title2 {
  color: #236647;
}

.cellgroup {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin: 0 32rpx;
  margin-bottom: 24rpx;
  margin-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  overflow: hidden;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.top-box--green + .cellgroup {
  margin: 0;
  border-radius: 28rpx 28rpx 0 0;
  background-color: #f4faf6;
  box-shadow: 0 -8rpx 30rpx rgba(44, 84, 62, 0.04);
}

.cellgroup__scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  background-color: #ffffff;
}

.top-box--green + .cellgroup .cellgroup__scroll {
  background-color: #f4faf6;
}

.bottom-gap {
  height: 100rpx;
}
