<view class="ms-tree-select" style="height: {{ height > 0 ? height + 'px' : '100%' }}">
  <scroll-view
    class="ms-tree-select__nav"
    scroll-y
    scroll-with-animation
    scroll-into-view="nav-{{ currentIndex }}"
  >
    <view
      wx:for="{{ items }}"
      wx:key="index"
      id="nav-{{ index }}"
      class="ms-tree-select__nav-item {{ currentIndex === index ? 'is-active' : '' }}"
      data-index="{{ index }}"
      bind:tap="onNav"
    >
      <text class="ms-tree-select__nav-text">{{ item.text }}</text>
    </view>
  </scroll-view>
  <scroll-view
    class="ms-tree-select__content"
    scroll-y
    scroll-into-view="{{ activeId ? 'venue-' + activeId : '' }}"
  >
    <view
      wx:for="{{ children }}"
      wx:key="id"
      id="venue-{{ item.id }}"
      class="ms-tree-select__item {{ activeId == item.id ? 'is-active' : '' }}"
      data-index="{{ index }}"
      bind:tap="onItem"
      hover-class="ms-tree-select__item--hover"
    >
      <text class="ms-tree-select__text">{{ item.text }}</text>
      <ms-icon wx:if="{{ activeId == item.id }}" name="checked" size="32rpx" color="#d31027" />
    </view>
    <view class="ms-tree-select__empty" wx:if="{{ children.length === 0 }}">该乡镇暂无场所</view>
  </scroll-view>
</view>
